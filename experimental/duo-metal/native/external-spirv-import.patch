@@ -0,0 +1,340 @@
+use super::*;
+use crate::budget::Budget;
+use crate::device::{Device, DeviceDescription, DevicePolicy};
+use crate::metal::PixelFormat;
+use crate::pipeline::descriptor::{
+    ColorAttachmentDescriptor, RenderPipelineDescriptor, StageSource,
+};
+#[path = "fixtures.rs"]
+mod fixtures;
+use fixtures::{FRAGMENT, VERTEX};
+
+fn device() -> Device {
+    let json = include_str!("../../../../metal2vulkan-validation/profiles/vk12-bare.json");
+    Device::new(
+        DeviceDescription::from_khronos_json(json, None).unwrap(),
+        DevicePolicy::default(),
+    )
+    .unwrap()
+}
+fn sha(words: &[u32]) -> Hash256 {
+    let bytes: Vec<u8> = words.iter().flat_map(|w| w.to_le_bytes()).collect();
+    Sha256::digest(bytes).into()
+}
+fn hex(s: &str) -> Hash256 {
+    std::array::from_fn(|i| u8::from_str_radix(&s[i * 2..i * 2 + 2], 16).unwrap())
+}
+fn input(device: &Device, words: &[u32], vertex: bool) -> ExternalSpirvStage {
+    ExternalSpirvStage::new(
+        words.to_vec(),
+        ExternalStageFacts {
+            stage: if vertex {
+                Stage::Vertex
+            } else {
+                Stage::Fragment
+            },
+            interface: if vertex {
+                ExternalStageInterface::VertexIndexPosition
+            } else {
+                ExternalStageInterface::FragmentColor0
+            },
+            entry_point: "main".into(),
+            profile: device.profile().fingerprint(),
+            source_air_sha256: hex(if vertex {
+                "b77b415a1ea7cf8d538e8e2cecdf2727b0da2f84d10f0192520b0bbc5bbbc5a1"
+            } else {
+                "ec06566083119c9aecba9f09abdf77420984aabdfbbb6a9c1ad965e25682ae8b"
+            }),
+            // A caller-owned producer identity is provenance, not proof of AIR equivalence.
+            compiler_sha256: Sha256::digest(b"owned-test-external-producer-v1").into(),
+            spirv_sha256: sha(words),
+        },
+    )
+}
+fn descriptor(device: &Device, format: PixelFormat) -> RenderPipelineDescriptor {
+    let import = |words, vertex| {
+        device
+            .profile()
+            .import_resource_free_spirv(&input(device, words, vertex))
+            .unwrap()
+    };
+    let mut d = RenderPipelineDescriptor::new(StageSource::Compiled(import(VERTEX, true)));
+    d.fragment = Some(StageSource::Compiled(import(FRAGMENT, false)));
+    d.color_attachments[0] = Some(ColorAttachmentDescriptor::new(format));
+    d
+}
+fn instruction(words: &[u32], opcode: u16) -> usize {
+    let mut at = 5;
+    while at < words.len() {
+        if words[at] & 0xffff == u32::from(opcode) {
+            return at;
+        }
+        at += (words[at] >> 16) as usize;
+    }
+    panic!("missing opcode {opcode}")
+}
+#[test]
+fn owned_identities_and_actual_pipeline_and_binding_planner() {
+    assert_eq!(VERTEX.len(), 165);
+    assert_eq!(FRAGMENT.len(), 98);
+    assert_eq!(
+        sha(VERTEX),
+        hex("82b49633668905609ec79e84c220a151fa793b598664b6851accfb2291ea5f59")
+    );
+    assert_eq!(
+        sha(FRAGMENT),
+        hex("5f3f25a3dcb8be992786ec1e9ba73257a38ff2180a07682a651e0c1eec5ad0f4")
+    );
+    let device = device();
+    let pipeline = device
+        .compile_render_pipeline(
+            &descriptor(&device, PixelFormat::RGBA32Float),
+            &Budget::standard(),
+        )
+        .unwrap();
+    assert_eq!(pipeline.stages.len(), 2);
+    assert_eq!(&*pipeline.stages[0].spirv, VERTEX);
+    assert_eq!(&*pipeline.stages[1].spirv, FRAGMENT);
+    for stage in &pipeline.stages {
+        assert_eq!(stage.entry_point, "main");
+        assert!(stage.specialization.constants.is_empty());
+        assert!(stage.required_subgroup_size.is_none());
+        assert!(stage.precision_notes.is_empty());
+        assert_eq!(
+            stage.strategies.entries["external.resource_free_spirv"].uses,
+            1
+        );
+        crate::spirv::testing::check_words_valid(
+            &stage.spirv,
+            &pipeline.requirements,
+            device.profile(),
+        )
+        .unwrap();
+    }
+    let plan = pipeline
+        .plan(&device, &crate::bind::BindShape::default())
+        .unwrap();
+    assert!(plan.descriptors.is_empty());
+    assert!(plan.vertex_buffers.is_empty());
+    assert!(plan.uses.is_empty());
+}
+#[test]
+fn actual_linker_keeps_unsupported_attachment_conversion_refusal() {
+    let device = device();
+    let result = device.compile_render_pipeline(
+        &descriptor(&device, PixelFormat::RGBA8Unorm),
+        &Budget::standard(),
+    );
+    assert!(matches!(
+        result,
+        Err(crate::error::Error::NeedsInput(
+            crate::error::RuntimeInput::ColorWrites
+        ))
+    ));
+}
+#[test]
+fn immutable_words_profiles_and_provenance_keys() {
+    let device = device();
+    let original = input(&device, VERTEX, true);
+    let compile = |stage: &ExternalSpirvStage| device.profile().import_resource_free_spirv(stage);
+    let first = compile(&original).unwrap();
+    let mut other = original.clone();
+    other.facts.compiler_sha256[0] ^= 1;
+    assert_ne!(first.key(), compile(&other).unwrap().key());
+    other = original.clone();
+    other.facts.source_air_sha256[0] ^= 1;
+    assert_ne!(first.key(), compile(&other).unwrap().key());
+    other = original.clone();
+    other.facts.profile[0] ^= 1;
+    assert_eq!(compile(&other).unwrap_err(), ExternalSpirvError::Profile);
+    other = original.clone();
+    other.facts.spirv_sha256[0] ^= 1;
+    assert_eq!(compile(&other).unwrap_err(), ExternalSpirvError::Digest);
+    other = original.clone();
+    other.facts.stage = Stage::Fragment;
+    assert_eq!(compile(&other).unwrap_err(), ExternalSpirvError::Interface);
+    other = original.clone();
+    other.facts.entry_point = "other".into();
+    assert_eq!(compile(&other).unwrap_err(), ExternalSpirvError::Interface);
+    other = original.clone();
+    other.facts.compiler_sha256 = [0; 32];
+    assert_eq!(compile(&other).unwrap_err(), ExternalSpirvError::Digest);
+}
+#[test]
+fn unknown_resource_specialization_attribute_and_bad_ir_refuse() {
+    let device = device();
+    let reject = |words: Vec<u32>, vertex: bool| {
+        device
+            .profile()
+            .import_resource_free_spirv(&input(&device, &words, vertex))
+            .unwrap_err()
+    };
+    for decoration in [33, 34] {
+        let mut words = FRAGMENT.to_vec();
+        let at = instruction(&words, 71);
+        words[at + 2] = decoration;
+        assert_eq!(reject(words, false), ExternalSpirvError::Resources);
+    }
+    let mut words = FRAGMENT.to_vec();
+    let at = instruction(&words, 71);
+    words[at + 2] = 1;
+    assert_eq!(reject(words, false), ExternalSpirvError::Specialization);
+    let mut words = FRAGMENT.to_vec();
+    let at = instruction(&words, 43);
+    words[at] = (words[at] & 0xffff0000) | 50;
+    assert_eq!(reject(words, false), ExternalSpirvError::Specialization);
+    let mut words = VERTEX.to_vec();
+    let at = instruction(&words, 71);
+    words[at + 2] = 30;
+    assert_eq!(reject(words, true), ExternalSpirvError::Interface);
+    let mut words = FRAGMENT.to_vec();
+    let at = instruction(&words, 71);
+    words[at + 3] = 1;
+    assert_eq!(reject(words, false), ExternalSpirvError::Interface);
+    let mut words = FRAGMENT.to_vec();
+    let at = instruction(&words, 59);
+    words[at + 3] = 2;
+    assert_eq!(reject(words, false), ExternalSpirvError::Resources);
+    let mut words = FRAGMENT.to_vec();
+    let at = instruction(&words, 22);
+    words[at + 2] = 64;
+    assert!(matches!(
+        reject(words, false),
+        ExternalSpirvError::Instruction(22)
+    ));
+    let mut words = VERTEX.to_vec();
+    let at = instruction(&words, 249);
+    words[at + 1] = 10;
+    assert_eq!(reject(words, true), invalid("backwards/invalid branch"));
+    let mut words = FRAGMENT.to_vec();
+    let at = instruction(&words, 62);
+    words[at + 2] = 11;
+    assert_eq!(reject(words, false), invalid("store type"));
+    let mut words = FRAGMENT.to_vec();
+    let at = instruction(&words, 62);
+    words.drain(at..at + 3);
+    assert_eq!(reject(words, false), ExternalSpirvError::Interface);
+    let mut words = FRAGMENT.to_vec();
+    let at = instruction(&words, 80);
+    words[at] = (words[at] & 0xffff0000) | 999;
+    assert_eq!(reject(words, false), ExternalSpirvError::Instruction(999));
+    let mut words = FRAGMENT.to_vec();
+    words[3] = 513;
+    assert_eq!(reject(words, false), ExternalSpirvError::Bounds);
+    let mut words = FRAGMENT.to_vec();
+    words[5] = 17;
+    assert_eq!(reject(words, false), ExternalSpirvError::Bounds);
+    let mut words = FRAGMENT.to_vec();
+    words.pop();
+    assert!(matches!(
+        reject(words, false),
+        ExternalSpirvError::Invalid(_)
+    ));
+}
+
+#[test]
+fn bounded_largest_module_batch() {
+    let device = device();
+    let mut words = FRAGMENT.to_vec();
+    let at = instruction(&words, 71);
+    // Valid forward OpName references stress the whole 4096-word budget.
+    let names = vec![[0x00030005, 4, 0]; (4096 - words.len()) / 3].concat();
+    words.splice(at..at, names);
+    assert!(words.len() <= 4096 && words.len() >= 4094);
+    let largest = input(&device, &words, false);
+    let start = std::time::Instant::now();
+    let mut slowest = std::time::Duration::ZERO;
+    for _ in 0..32 {
+        let row = std::time::Instant::now();
+        let compiled = device
+            .profile()
+            .import_resource_free_spirv(&largest)
+            .unwrap();
+        assert_eq!(compiled.artifact().module.words.len(), words.len());
+        slowest = slowest.max(row.elapsed());
+    }
+    crate::spirv::testing::check_words_valid(
+        &words,
+        &device
+            .profile()
+            .import_resource_free_spirv(&largest)
+            .unwrap()
+            .requirements(),
+        device.profile(),
+    )
+    .unwrap();
+    assert!(slowest < std::time::Duration::from_secs(20));
+    eprintln!(
+        "external import batch=32 words={} elapsed_us={} slowest_us={}",
+        words.len(),
+        start.elapsed().as_micros(),
+        slowest.as_micros()
+    );
+    words.resize(4097, 0);
+    assert_eq!(
+        device
+            .profile()
+            .import_resource_free_spirv(&input(&device, &words, false))
+            .unwrap_err(),
+        ExternalSpirvError::Bounds
+    );
+}
+
+#[test]
+fn accepted_single_word_mutations_remain_real_valid_spirv() {
+    let device = device();
+    let mut accepted = 0;
+    for (original, vertex) in [(VERTEX, true), (FRAGMENT, false)] {
+        for index in 0..original.len() {
+            for value in [
+                0,
+                1,
+                u32::MAX,
+                original[index] ^ 1,
+                original[index] ^ 0x10000,
+            ] {
+                let mut words = original.to_vec();
+                words[index] = value;
+                if let Ok(compiled) = device
+                    .profile()
+                    .import_resource_free_spirv(&input(&device, &words, vertex))
+                {
+                    crate::spirv::testing::check_words_valid(&compiled.artifact().module.words,compiled.requirements(),device.profile())
+                        .unwrap_or_else(|e|panic!("accepted invalid stage vertex={vertex} index={index} value={value:#x}: {e}"));
+                    accepted += 1;
+                }
+            }
+        }
+    }
+    assert!(accepted > 100);
+    eprintln!("external mutation L3 checks accepted={accepted}");
+}
+
+#[test]
+fn imported_stage_uses_the_existing_cache_contract() {
+    let device = device();
+    let original = device
+        .profile()
+        .import_resource_free_spirv(&input(&device, FRAGMENT, false))
+        .unwrap();
+    let bytes = original.to_bytes();
+    let restored = CompiledFunction::from_bytes_for_key(&bytes, original.key(), &device).unwrap();
+    assert_eq!(original, restored);
+    let foreign = FunctionCompileKey::new([7; 32]);
+    assert!(CompiledFunction::from_bytes_for_key(&bytes, &foreign, &device).is_err());
+    let mut corrupt = bytes;
+    let end = corrupt.len() - 1;
+    corrupt[end] ^= 1;
+    assert!(CompiledFunction::from_bytes_for_key(&corrupt, original.key(), &device).is_err());
+    let mut descriptor = descriptor(&device, PixelFormat::RGBA32Float);
+    let direct = device
+        .compile_render_pipeline(&descriptor, &Budget::standard())
+        .unwrap();
+    descriptor.fragment = Some(StageSource::Compiled(restored));
+    assert_eq!(
+        direct,
+        device
+            .compile_render_pipeline(&descriptor, &Budget::standard())
+            .unwrap()
+    );
+}
