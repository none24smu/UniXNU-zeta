+#!/usr/bin/env python3
+"""Build actual core/VM bodies over host peers, source-only staging on and off."""
+import argparse
+from pathlib import Path
+import os
+import subprocess
+import tempfile
+
+root=Path(__file__).resolve().parents[1]
+p=argparse.ArgumentParser(description=__doc__)
+p.add_argument('--unixnu',type=Path,default=root.parents[2]/'UniXNU')
+args=p.parse_args()
+smmu=args.unixnu/'kits/ArmSmmu4K';pm4=args.unixnu/'kits/AdrenoPM4'
+with tempfile.TemporaryDirectory(prefix='resource-client-') as tmp:
+    out=Path(tmp);inc=out/'include'
+    for name in ['IOKit/IOTypes.h','IOKit/IOReturn.h','IOKit/IOBufferMemoryDescriptor.h','IOKit/IOLib.h','kern/task.h']:
+        q=inc/name;q.parent.mkdir(parents=True,exist_ok=True);q.write_text('#include "XnuMemoryFixture.h"\n')
+    flags=['-O1','-g','-Wall','-Wextra','-Werror','-Wno-missing-field-initializers','-fsanitize=address,undefined']
+    objects=[]
+    for source in [*(smmu/(s+'.c') for s in ['ArmSmmu4KContext','ArmSmmu4KProgram','ArmSmmu4KLive','ArmSmmu4KStreams']),pm4/'AdrenoPM4.c']:
+        obj=out/(source.stem+'.o')
+        subprocess.run(['clang','-std=c11',*flags,'-c',str(source),'-o',str(obj)],check=True);objects.append(obj)
+    names=['NativeAdrenoMemory','NativeAdrenoSmmuMemory','NativeAdrenoVm','NativeAdrenoRing','NativeAdrenoSubmit',
+           'NativeAdrenoUserClient','NativeAdrenoClient','NativeAdrenoTimer','NativeAdrenoResources','NativeAdrenoResourceTransaction','NativeAdrenoResourceQueue']
+    for enabled in [0,1]:
+        executable=out/('test-client-'+str(enabled))
+        subprocess.run(['clang++','-std=c++23',*flags,'-DNATIVE_ADRENO_EXPERIMENTAL_RESOURCE_STAGING='+str(enabled),
+            '-I'+str(inc),'-I'+str(root/'tests'),'-I'+str(root),'-I'+str(smmu),'-I'+str(pm4),
+            *(str(root/(n+'.cpp')) for n in names),str(root/'tests/test_client.cpp'),*map(str,objects),'-o',str(executable)],check=True)
+        # Existing software-SMMU fixtures intentionally retain mounted table roots.
+        # New staging metadata is checked explicitly for exact restoration.
+        subprocess.run([str(executable)],env={**os.environ,'ASAN_OPTIONS':'detect_leaks=0'},check=True)
