@@ -0,0 +1,96 @@
+/* SPDX-License-Identifier: MIT -- host harness, never a GPU emulator */
+#pragma once
+#include "NativeAdrenoResources.h"
+#include <cassert>
+#include <cstdlib>
+#include <map>
+#include <vector>
+namespace resource_test {
+namespace nr=NativeAdrenoResources;
+struct Fixture {
+    std::vector<nr::Mapping> mappings{
+        {1,11,99,100,1001,0x10000,4096,0,3,0},
+        {2,12,99,200,1002,0x20000,8192,0,3,0},
+        {3,13,99,300,1003,0x40000,4096,0,3,0}};
+    std::map<uint64_t,int> pins;
+    std::vector<nr::CacheSpan> published,acquired;
+    size_t allocations=0,live_allocations=0,fail_allocation=0;
+    size_t live_bytes=0,peak_bytes=0;
+    std::map<void *,size_t> allocation_sizes;
+    size_t lookups=0,holds=0,releases=0,publishes=0,enqueues=0,acquires=0,quiesces=0;
+    size_t enqueue_uses=0,enqueue_commands=0,fail_hold=0,release_attempts=0,fail_release=0;
+    nr::Error publish_error=nr::Error::Ok,acquire_error=nr::Error::Ok;
+    nr::SubmitResult result{nr::Error::Ok,nr::Acceptance::Accepted,77};
+    nr::Completion completion=nr::Completion::Pending;
+    bool quiescent=false;
+    std::vector<nr::Release> release_reasons;
+    static nr::Capabilities caps() {return {1,7,4096,128};}
+    nr::Mapping *mapping(uint64_t handle) {
+        for(auto &m:mappings)if(m.handle==handle)return &m;
+        return nullptr;
+    }
+    nr::Allocator allocator() {
+        return {this,[](void *ctx,size_t n)->void * {
+            auto &f=*static_cast<Fixture *>(ctx);
+            if(++f.allocations==f.fail_allocation)return nullptr;
+            void *p=std::malloc(n);if(p) {
+                ++f.live_allocations;f.live_bytes+=n;
+                if(f.live_bytes>f.peak_bytes)f.peak_bytes=f.live_bytes;
+                f.allocation_sizes[p]=n;
+            }
+            return p;
+        },[](void *ctx,void *p,size_t n) {
+            auto &f=*static_cast<Fixture *>(ctx);assert(f.live_allocations && f.allocation_sizes.at(p)==n);
+            --f.live_allocations;f.live_bytes-=n;f.allocation_sizes.erase(p);std::free(p);
+        }};
+    }
+    nr::Hooks hooks() {
+        return {this,[](void *ctx,uint64_t h,nr::Mapping *out) {
+            auto &f=*static_cast<Fixture *>(ctx);++f.lookups;
+            if(auto *m=f.mapping(h)) {*out=*m;return nr::Error::Ok;}
+            return nr::Error::Stale;
+        },[](void *ctx,const nr::Mapping &m) {
+            auto &f=*static_cast<Fixture *>(ctx);
+            if(++f.holds==f.fail_hold)return nr::Error::PinFailed;
+            const auto *p=f.mapping(m.handle);
+            if(!p || p->generation!=m.generation || p->owner!=m.owner || p->mapping!=m.mapping ||
+               p->backing!=m.backing || p->iova!=m.iova || p->bytes!=m.bytes ||
+               p->backing_offset!=m.backing_offset || p->permissions!=m.permissions)return nr::Error::Stale;
+            ++f.pins[m.mapping];return nr::Error::Ok;
+        },[](void *ctx,const nr::Mapping &m,nr::Release why) {
+            auto &f=*static_cast<Fixture *>(ctx);
+            if(++f.release_attempts==f.fail_release)return nr::Error::Backend;
+            ++f.releases;
+            assert(f.pins[m.mapping]>0);--f.pins[m.mapping];f.release_reasons.push_back(why);
+            return nr::Error::Ok;
+        },[](void *ctx,const nr::CacheSpan *s,size_t n) {
+            auto &f=*static_cast<Fixture *>(ctx);++f.publishes;f.published.assign(s,s+n);return f.publish_error;
+        },[](void *ctx,uint64_t owner,uint64_t queue,const nr::Use *,size_t n,const nr::Command *,size_t c) {
+            assert(owner==99 && queue==1);
+            auto &f=*static_cast<Fixture *>(ctx);++f.enqueues;f.enqueue_uses=n;f.enqueue_commands=c;return f.result;
+        },[](void *ctx,uint64_t fence) {
+            auto &f=*static_cast<Fixture *>(ctx);assert(fence==77);return f.completion;
+        },[](void *ctx,const nr::CacheSpan *s,size_t n) {
+            auto &f=*static_cast<Fixture *>(ctx);++f.acquires;f.acquired.assign(s,s+n);return f.acquire_error;
+        },[](void *ctx) {
+            auto &f=*static_cast<Fixture *>(ctx);++f.quiesces;return f.quiescent;
+        }};
+    }
+    std::vector<nr::Resource> resources() const {
+        return {{1,11,0,4096,nr::Read|nr::Execute,0},{2,12,0,8192,nr::Write,0},
+                {3,13,0,4096,nr::Read,0}};
+    }
+    nr::Job *make() {
+        auto r=resources();nr::Ib ib{1,11,16,64};nr::Job *job=nullptr;
+        assert(nr::Job::create(caps(),99,1,r.data(),r.size(),&ib,1,allocator(),hooks(),&job)==nr::Error::Ok);
+        return job;
+    }
+    void finish(nr::Job *job) {
+        completion=nr::Completion::Complete;
+        assert(job->poll()==nr::Error::Ok);
+        assert(nr::Job::destroy(job)==nr::Error::Ok);
+        assert(!live_allocations);
+        for(auto pin:pins)assert(pin.second==0);
+    }
+};
+}
