+/// (every word and vector field, so a draw's fields allocate nothing), more in a vector (a capture
+/// layout, a dispatch region).
+pub(crate) enum FieldBytes {
+    Inline {
+        bytes: [u8; FieldBytes::INLINE],
+        len: u8,
+    },
+    Heap(Vec<u8>),
