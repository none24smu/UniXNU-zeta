+#!/usr/bin/env python3
+"""Plain ARM64 object check with authored declarations; NOT an XNU SDK build."""
+import argparse
+from pathlib import Path
+import hashlib
+import json
+import subprocess
+import struct
+
+root=Path(__file__).resolve().parents[1]
+p=argparse.ArgumentParser(description=__doc__)
+p.add_argument('--unixnu',type=Path,default=root.parents[2]/'UniXNU')
+p.add_argument('--output',type=Path,required=True)
+a=p.parse_args();out=a.output.resolve();out.mkdir(parents=True,exist_ok=True)
+inc=out/'declarations';(inc/'IOKit').mkdir(parents=True,exist_ok=True)
+declarations={
+    'IOKit/IOTypes.h':'''#pragma once
+#include <stddef.h>
+#include <stdint.h>
+typedef int IOReturn;
+extern const IOReturn kIOReturnSuccess,kIOReturnBadArgument,kIOReturnBusy,kIOReturnNoResources,
+    kIOReturnNoMemory,kIOReturnUnsupported,kIOReturnNotReady,kIOReturnIOError,kIOReturnTimeout;
+''',
+    'IOKit/IOLib.h':'''#pragma once
+#include "IOTypes.h"
+extern "C" void *IOMalloc(size_t);
+extern "C" void IOFree(void *,size_t);
+#define IONewData(type,count) static_cast<type *>(IOMalloc(sizeof(type)*(count)))
+#define IODeleteData(ptr,type,count) do {IOFree(ptr,sizeof(type)*(count));ptr=nullptr;}while(0)
+''',
+    'new':'''#pragma once
+#include <stddef.h>
+inline void *operator new(size_t,void *p) noexcept {return p;}
+''',
+    'string.h':'''#pragma once
+#include <stddef.h>
+extern "C" void *memcpy(void *,const void *,size_t);
+extern "C" void *memset(void *,int,size_t);
+extern "C" int memcmp(const void *,const void *,size_t);
+'''}
+for name,text in declarations.items():(inc/name).write_text(text)
+builtin=subprocess.check_output(['clang++','-print-resource-dir'],text=True).strip()
+records=[]
+for enabled in [0,1]:
+    for name in ['NativeAdrenoUserClient','NativeAdrenoResources','NativeAdrenoResourceTransaction']:
+        source=root/(name+'.cpp');obj=out/(name+f'-staging{enabled}.o')
+        cmd=['clang++','-target','arm64-apple-ios17.0','-mcpu=generic','-march=armv8-a',
+             '-std=c++23','-ffreestanding','-fno-exceptions','-fno-rtti','-nostdinc','-nostdinc++',
+             '-isystem',builtin+'/include','-I'+str(inc),'-I'+str(root),
+             '-I'+str(a.unixnu/'kits/ArmSmmu4K'),'-I'+str(a.unixnu/'kits/AdrenoPM4'),
+             '-DNATIVE_ADRENO_EXPERIMENTAL_RESOURCE_STAGING='+str(enabled),
+             '-O1','-Wall','-Wextra','-Werror','-c',str(source),'-o',str(obj)]
+        subprocess.run(cmd,check=True)
+        data=obj.read_bytes()
+        require=data[:4]==bytes.fromhex('cffaedfe') and struct.unpack_from('<I',data,4)[0]==0x0100000c
+        if not require:raise RuntimeError('not Mach-O: '+str(obj))
+        records.append({'source':name+'.cpp','staging':enabled,'command':cmd,
+                        'sha256':hashlib.sha256(obj.read_bytes()).hexdigest()})
+record={'scope':'declaration-only ARMv8-A Mach-O object generation; no XNU SDK, linking or execution proof',
+        'native_publish_compiled':False,'records':records}
