@@ -0,0 +1,39 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_RESOURCE_QUEUE_H
+#define NATIVE_ADRENO_RESOURCE_QUEUE_H
+#include "NativeAdrenoResources.h"
+#include "NativeAdrenoVm.h"
+#include "NativeAdrenoRing.h"
+
+/* Internal single-in-flight complete-resource path; NOT a wire method or a
+ * readiness capability. Caller owns this context, all callback storage, the VM
+ * and ring until every Job is destroyed. All namespace/cache/queue operations
+ * require one gate, exclusive CPU access to whole used BOs, no physical import
+ * aliases and no competing legacy submissions. These are caller obligations,
+ * not established by configuring this object. No reset/quiescence is invented.
+ * Source profile stays disabled pending actual native/ownership qualification. */
+class NativeAdrenoResourceQueue final {
+public:
+    using Lookup=NativeAdrenoResources::Error (*)(void *,uint64_t,NativeAdrenoResources::Mapping *);
+    NativeAdrenoResourceQueue(NativeAdrenoVm &vm,NativeAdrenoRing &ring,
+        const NativeAdrenoRingClock &clock,uint64_t owner,uint64_t queue,
+        void *context,Lookup by_handle,Lookup by_backing):
+        vm_(vm),ring_(ring),clock_(clock),owner_(owner),queue_(queue),
+        context_(context),by_handle_(by_handle),by_backing_(by_backing) {}
+    NativeAdrenoResources::Hooks hooks();
+private:
+    NativeAdrenoVm &vm_;
+    NativeAdrenoRing &ring_;
+    NativeAdrenoRingClock clock_;
+    uint64_t owner_,queue_;
+    void *context_;
+    Lookup by_handle_,by_backing_;
+    NativeAdrenoResources::Error lookup(uint64_t,NativeAdrenoResources::Mapping *);
+    NativeAdrenoResources::Error revalidate(const NativeAdrenoResources::Mapping &);
+    NativeAdrenoResources::Error cacheMapping(const NativeAdrenoResources::CacheSpan &,
+                                            NativeAdrenoResources::Mapping *);
+    NativeAdrenoResources::Error maintain(const NativeAdrenoResources::CacheSpan *,size_t,bool acquire);
+    NativeAdrenoResources::SubmitResult enqueue(uint64_t,uint64_t,const NativeAdrenoResources::Use *,size_t,
+                                               const NativeAdrenoResources::Command *,size_t);
+};
+#endif
diff --git a/NativeAdrenoResourceTransaction.cpp b/NativeAdrenoResourceTransaction.cpp
new file mode 100644
index 0000000..a270553
--- /dev/null
+++ b/NativeAdrenoResourceTransaction.cpp
@@ -0,0 +1,186 @@
+/* SPDX-License-Identifier: MIT */
+#include "NativeAdrenoResourceTransaction.h"
+#include <new>
+#include <string.h>
+#if defined(__BYTE_ORDER__) && __BYTE_ORDER__ != __ORDER_LITTLE_ENDIAN__
+#error Resource transaction wire schema requires little endian
+#endif
+namespace NativeAdrenoResources {
+namespace Transaction {
+Schema schema() { return {Magic,Version,RequestBytes,ReplyBytes,MaxResources,MaxIbs,
+                         CompleteSet|RetainUntilCompletion|ScopedCache,0}; }
+static bool zero(const uint8_t *p,size_t n) {
+    for(size_t i=0;i<n;++i)if(p[i])return false;
+    return true;
+}
+Session::Session(uint64_t owner,uint64_t incarnation,const Capabilities &caps,
+                 const Allocator &allocator,const Hooks &hooks):
+    owner_(owner),incarnation_(incarnation),caps_(caps),allocator_(allocator),hooks_(hooks) {}
+Error Session::create(uint64_t owner,uint64_t incarnation,const Capabilities &caps,
+                      const Allocator &a,const Hooks &h,Session **out) {
+    if(!out)return Error::Invalid;
+    *out=nullptr;
+    if(!supported(caps))return Error::Unsupported;
+    if(!owner || !incarnation || !a.allocate || !a.free || !h.lookup || !h.hold ||
+       !h.release || !h.publish || !h.enqueue || !h.completion || !h.acquire || !h.quiesce)
+        return Error::Invalid;
+    void *p=a.allocate(a.context,sizeof(Session));
+    if(!p)return Error::NoMemory;
+    *out=new(p) Session(owner,incarnation,caps,a,h);return Error::Ok;
+}
+Error Session::createValidationOnly(uint64_t owner,uint64_t incarnation,size_t maximum,
+    const Allocator &a,void *context,Error (*lookup)(void *,uint64_t,Mapping *),Session **out) {
+    // Internal Job flags enable its immutable validator only; none are advertised
+    // as native execution readiness. Private Job storage never escapes Session.
+    Hooks h{context,lookup,
+        [](void *,const Mapping &){return Error::Unsupported;},
+        [](void *,const Mapping &,Release){return Error::Unsupported;},
+        [](void *,const CacheSpan *,size_t){return Error::Unsupported;},
+        [](void *,uint64_t,uint64_t,const Use *,size_t,const Command *,size_t){
+            return SubmitResult{Error::Unsupported,Acceptance::Rejected,0};},
+        [](void *,uint64_t){return Completion::Uncertain;},
+        [](void *,const CacheSpan *,size_t){return Error::Unsupported;},
+        [](void *){return false;}};
+    const Error error=create(owner,incarnation,{1,7,maximum,MaxIbs},a,h,out);
+    if(error==Error::Ok)(*out)->validation_only_=true;
+    return error;
+}
+State Session::state() const {
+    if(closed_)return State::Closed;
+    if(job_)switch(job_->state()) {
+    case Job::State::Prepared:return State::Sealed;
+    case Job::State::Rejected:return State::Rejected;
+    case Job::State::InFlight:return State::InFlight;
+    case Job::State::Uncertain:return State::Uncertain;
+    case Job::State::Completed:return State::Completed;
+    }
+    return active_.generation?State::Uploading:State::Idle;
+}
+Reply Session::reply(Status s,Error detail,bool identity) const {
+    return {uint32_t(s),uint32_t(state()),identity?active_.id:0,
+            identity?active_.generation:0,identity?next_sequence_:0,uint32_t(detail)};
+}
+bool Session::matches(Token t) const {
+    return active_.id && t.id==active_.id && t.generation==active_.generation;
+}
+void Session::discardUpload() {
+    if(resources_)allocator_.free(allocator_.context,resources_,resource_total_*sizeof(Resource));
+    if(ibs_)allocator_.free(allocator_.context,ibs_,ib_total_*sizeof(Ib));
+    resources_=nullptr;ibs_=nullptr;
+}
+Reply Session::begin(const Request &r) {
+    if(r.token || r.generation || r.sequence || r.count || r.payload_bytes!=8 ||
+       !r.total_resources || r.total_resources>caps_.max_resources ||
+       !r.total_ibs || r.total_ibs>caps_.max_ibs ||
+       !zero(r.payload+8,sizeof(r.payload)-8))return reply(Status::BadPacket);
+    if(active_.generation || job_)return reply(Status::Busy);
+    if(generation_==UINT64_MAX)return reply(Status::Unsupported);
+    // Burn generations even on allocation failure; no issued token can recur.
+    const uint64_t generation=++generation_;
+    auto *resources=static_cast<Resource *>(allocator_.allocate(allocator_.context,r.total_resources*sizeof(Resource)));
+    auto *ibs=static_cast<Ib *>(allocator_.allocate(allocator_.context,r.total_ibs*sizeof(Ib)));
+    if(!resources || !ibs) {
+        if(resources)allocator_.free(allocator_.context,resources,r.total_resources*sizeof(Resource));
+        if(ibs)allocator_.free(allocator_.context,ibs,r.total_ibs*sizeof(Ib));
+        return reply(Status::NoMemory);
+    }
+    resources_=resources;ibs_=ibs;
+    resource_total_=r.total_resources;ib_total_=r.total_ibs;
+    resource_count_=ib_count_=0;next_sequence_=1;
+    memcpy(&queue_,r.payload,8);
+    active_={incarnation_,generation};return reply(Status::Ok);
+}
+Reply Session::append(const Request &r,bool resources) {
+    if(job_)return reply(Status::Busy);
+    const size_t stride=resources?sizeof(Resource):sizeof(Ib);
+    const size_t maximum=resources?ResourcePageCount:IbPageCount;
+    if(!r.count || r.count>maximum || r.payload_bytes!=r.count*stride ||
+       !zero(r.payload+r.payload_bytes,sizeof(r.payload)-r.payload_bytes))return reply(Status::BadPacket);
+    if(resources) {
+        if(ib_count_ || r.count>resource_total_-resource_count_)return reply(Status::BadPacket);
+        Resource page[ResourcePageCount];memcpy(page,r.payload,r.payload_bytes);
+        for(size_t i=0;i<r.count;++i) {
+            const Resource &p=page[i];
+            if(!p.handle || !p.generation || p.offset || !p.bytes || p.reserved ||
+               !(p.access&(Read|Write)) || (p.access&~uint32_t(Read|Write|Execute)) ||
+               ((p.access&Execute) && !(p.access&Read)))return reply(Status::BadPacket);
+        }
+        memcpy(resources_+resource_count_,page,r.payload_bytes);resource_count_+=r.count;
+    } else {
+        if(resource_count_!=resource_total_ || r.count>ib_total_-ib_count_)return reply(Status::BadPacket);
+        Ib page[IbPageCount];memcpy(page,r.payload,r.payload_bytes);
+        for(size_t i=0;i<r.count;++i)if(!page[i].handle || !page[i].generation ||
+            !page[i].bytes || (page[i].offset&3) || (page[i].bytes&3))return reply(Status::BadPacket);
+        memcpy(ibs_+ib_count_,page,r.payload_bytes);ib_count_+=r.count;
+    }
+    ++next_sequence_;return reply(Status::Ok);
+}
+Reply Session::seal() {
+    if(job_)return reply(Status::Busy);
+    if(resource_count_!=resource_total_ || ib_count_!=ib_total_)return reply(Status::BadPacket);
+    // Version1 carries full BOs only; independently check the declared extent.
+    // Lookup is read-only. Job creation then validates ownership/ranges/IBs and
+    // copies all bytes. No hold, cache operation or GPU enqueue occurs at seal.
+    for(size_t i=0;i<resource_total_;++i) {
+        Mapping m{};
+        const Error e=hooks_.lookup(hooks_.context,resources_[i].handle,&m);
+        if(e!=Error::Ok)return reply(Status::Validation,e);
+        if(m.owner!=owner_)return reply(Status::Validation,Error::Ownership);
+        if(m.generation!=resources_[i].generation)return reply(Status::Validation,Error::Stale);
+        if(resources_[i].bytes!=m.bytes)return reply(Status::Validation,Error::Bounds);
+    }
+    const Error e=Job::create(caps_,owner_,queue_,resources_,resource_total_,ibs_,ib_total_,
+                              allocator_,hooks_,&job_);
+    if(e!=Error::Ok)return reply(e==Error::NoMemory?Status::NoMemory:Status::Validation,e);
+    discardUpload();++next_sequence_;return reply(Status::Ok);
+}
+Reply Session::process(uint64_t owner,const void *bytes,size_t size) {
+    if(owner!=owner_)return reply(Status::Ownership,Error::Ownership,false);
+    if(closed_)return reply(Status::Closed,Error::Busy,false);
+    if(!bytes || size!=sizeof(Request))return reply(Status::BadPacket);
+    Request r;memcpy(&r,bytes,sizeof(r));
+    if(r.magic!=Magic || r.version!=Version || r.flags || r.reserved ||
+       r.payload_bytes>sizeof(r.payload))return reply(Status::BadPacket);
+    const Operation op=Operation(r.operation);
+    if(op==Operation::Begin)return begin(r);
+    if(op!=Operation::Resources && op!=Operation::Ibs && op!=Operation::Seal && op!=Operation::Abort)
+        return reply(Status::Unsupported);
+    if(!matches({r.token,r.generation}))return reply(Status::Stale);
+    if(r.total_resources!=resource_total_ || r.total_ibs!=ib_total_)return reply(Status::BadPacket);
+    if(r.sequence!=next_sequence_)return reply(Status::Sequence);
+    if(op==Operation::Resources || op==Operation::Ibs)return append(r,op==Operation::Resources);
+    if(r.count || r.payload_bytes || !zero(r.payload,sizeof(r.payload)))return reply(Status::BadPacket);
+    if(op==Operation::Seal)return seal();
+    if(job_) {
+        const Error e=Job::destroy(job_);
+        if(e!=Error::Ok)return reply(Status::Busy,e);
+        job_=nullptr;
+    }
+    discardUpload();active_={};resource_total_=ib_total_=resource_count_=ib_count_=0;next_sequence_=0;
+    return reply(Status::Ok);
+}
+Error Session::submitSealed(uint64_t owner,Token token) {
+    if(owner!=owner_)return Error::Ownership;
+    if(validation_only_)return Error::Unsupported;
+    if(closed_ || !matches(token) || !job_)return Error::Stale;
+    return job_->submit();
+}
+Error Session::poll() { return job_?job_->poll():Error::Busy; }
+Error Session::recover() { return job_?job_->recover():Error::Busy; }
+Error Session::close() {
+    closed_=true;discardUpload();
+    if(job_) {
+        const Error e=Job::destroy(job_);if(e!=Error::Ok)return e;
+        job_=nullptr;
+    }
+    active_={};resource_total_=ib_total_=resource_count_=ib_count_=0;next_sequence_=0;
+    return Error::Ok;
+}
+Error Session::destroy(Session *session) {
+    if(!session)return Error::Invalid;
+    const Error e=session->close();if(e!=Error::Ok)return e;
+    const Allocator a=session->allocator_;
+    session->~Session();a.free(a.context,session,sizeof(Session));return Error::Ok;
+}
+}
+}
diff --git a/NativeAdrenoResourceTransaction.h b/NativeAdrenoResourceTransaction.h
new file mode 100644
index 0000000..58058b2
--- /dev/null
+++ b/NativeAdrenoResourceTransaction.h
@@ -0,0 +1,97 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_RESOURCE_TRANSACTION_H
+#define NATIVE_ADRENO_RESOURCE_TRANSACTION_H
+#include "NativeAdrenoResources.h"
+
+namespace NativeAdrenoResources {
+namespace Transaction {
+/* Experimental fixed inline schema. No published ABI/runtime capability selects
+ * it; the integration header reserves default-off staging selectors only.
+ * Authenticated owner/connection identity is OUT OF BAND. */
+enum : uint32_t { Magic=0x31524d4e, Version=1, RequestBytes=408, ReplyBytes=32,
+                 ResourcePageCount=8, IbPageCount=11 };
+enum class Operation : uint32_t { Begin=1, Resources=2, Ibs=3, Seal=4, Abort=5 };
+enum class Status : uint32_t { Ok=0, Unsupported=1, BadPacket=2, Ownership=3,
+                              Stale=4, Sequence=5, Busy=6, NoMemory=7,
+                              Validation=8, Closed=9 };
+enum class State : uint32_t { Idle=0, Uploading=1, Sealed=2, InFlight=3,
+                             Uncertain=4, Completed=5, Rejected=6, Closed=7 };
+struct Token { uint64_t id,generation; };
+struct Request {
+    uint32_t magic,version,operation,flags;
+    uint64_t token,generation;
+    uint32_t sequence,count,total_resources,total_ibs,payload_bytes,reserved;
+    uint8_t payload[352];
+};
+struct Reply {
+    uint32_t status,state;
+    uint64_t token,generation;
+    uint32_t next_sequence,detail; /* detail is internal Error, never a GPU claim */
+};
+/* Schema description, NOT a readiness/capability advertisement. A future exact
+ * query method may publish readiness only after real VM/cache/pins implement it. */
+struct Schema {
+    uint32_t magic,version,request_bytes,reply_bytes;
+    uint32_t max_resources,max_ibs,required_job_flags,reserved;
+};
+Schema schema();
+static_assert(sizeof(Resource)==40,"resource record layout");
+static_assert(sizeof(Ib)==32,"IB record layout");
+static_assert(sizeof(Request)==408,"inline transaction request layout");
+static_assert(offsetof(Request,payload)==56,"inline transaction payload offset");
+static_assert(sizeof(Reply)==32,"transaction reply layout");
+static_assert(offsetof(Reply,token)==8 && offsetof(Reply,detail)==28,"transaction reply offsets");
+static_assert(sizeof(Schema)==32,"schema layout");
+
+class Session final {
+public:
+    /* incarnation is a nonzero kernel-issued connection cookie, never reused for
+     * that owner across close/reconnect, never derived from a userspace fd. One transaction per
+     * session, finite monotonic generation, no implicit eviction. */
+    static Error create(uint64_t owner,uint64_t incarnation,const Capabilities &,
+                        const Allocator &,const Hooks &,Session **);
+    /* Kernel staging receiver: real read-only lookup, no executable capability.
+     * Both the Session submit guard and all execution hooks refuse GPU work. */
+    static Error createValidationOnly(uint64_t owner,uint64_t incarnation,size_t max_resources,
+        const Allocator &,void *lookup_context,Error (*lookup)(void *,uint64_t,Mapping *),Session **);
+    Reply process(uint64_t authenticated_owner,const void *,size_t);
+    /* Future kernel submit integration, deliberately not a wire operation. */
+    Error submitSealed(uint64_t authenticated_owner,Token);
+    Error poll();
+    Error recover();
+    Error close();
+    static Error destroy(Session *); /* Busy retains unresolved job AND session */
+    State state() const;
+    Token token() const { return active_; }
+    size_t receivedResources() const { return resource_count_; }
+    size_t receivedIbs() const { return ib_count_; }
+private:
+    Session(uint64_t,uint64_t,const Capabilities &,const Allocator &,const Hooks &);
+    ~Session()=default;
+    Session(const Session &)=delete;
+    Session &operator=(const Session &)=delete;
+    Reply reply(Status,Error detail=Error::Ok,bool identity=true) const;
+    Reply begin(const Request &);
+    Reply append(const Request &,bool resources);
+    Reply seal();
+    void discardUpload();
+    bool matches(Token) const;
+    uint64_t owner_,incarnation_,generation_=0,queue_=0;
+    Capabilities caps_;
+    Allocator allocator_;
+    Hooks hooks_;
+    Token active_{};
+    Resource *resources_=nullptr;
+    Ib *ibs_=nullptr;
+    size_t resource_total_=0,ib_total_=0,resource_count_=0,ib_count_=0;
+    uint32_t next_sequence_=0;
+    Job *job_=nullptr;
+    bool closed_=false;
+    bool validation_only_=false;
+};
+/* All operations and namespace mutation require the same external serialization.
+ * On close Busy, retirement infrastructure must own this Session, Hooks.context
+ * and allocator until actual completion/quiescence; never free with the client. */
+}
+}
+#endif
diff --git a/NativeAdrenoResources.cpp b/NativeAdrenoResources.cpp
new file mode 100644
index 0000000..0f26e76
--- /dev/null
+++ b/NativeAdrenoResources.cpp
@@ -0,0 +1,175 @@
+/* SPDX-License-Identifier: MIT */
+#include "NativeAdrenoResources.h"
+#include <new>
+
+namespace NativeAdrenoResources {
+static bool fits(uint64_t offset,uint64_t bytes,uint64_t limit) {
+    return bytes && offset<=limit && bytes<=limit-offset;
+}
+static bool sameMapping(const Mapping &a,const Mapping &b) {
+    return a.generation==b.generation && a.owner==b.owner && a.backing==b.backing &&
+           a.mapping==b.mapping && a.iova==b.iova && a.bytes==b.bytes &&
+           a.backing_offset==b.backing_offset && a.permissions==b.permissions;
+}
+bool supported(const Capabilities &c) {
+    return c.version==1 && c.flags==(CompleteSet|RetainUntilCompletion|ScopedCache) &&
+           c.max_resources && c.max_resources<=MaxResources && c.max_ibs && c.max_ibs<=MaxIbs;
+}
+Job::Job(const Allocator &a,const Hooks &h):allocator_(a),hooks_(h) {}
+Error Job::create(const Capabilities &caps,uint64_t owner,uint64_t queue,const Resource *resources,size_t n,
+                  const Ib *ibs,size_t ni,const Allocator &a,const Hooks &h,Job **out) {
+    if(!out)return Error::Invalid;
+    *out=nullptr;
+    if(!supported(caps))return Error::Unsupported;
+    if(!owner || !resources || !ibs || !n || n>caps.max_resources || !ni || ni>caps.max_ibs ||
+       !a.allocate || !a.free || !h.lookup || !h.hold || !h.release || !h.publish ||
+       !h.enqueue || !h.completion || !h.acquire || !h.quiesce)return Error::Invalid;
+    void *memory=a.allocate(a.context,sizeof(Job));
+    if(!memory)return Error::NoMemory;
+    Job *job=new(memory) Job(a,h);
+    job->owner_=owner;job->queue_=queue;
+    job->resource_capacity_=n;job->command_capacity_=ni;
+    job->uses_=static_cast<Use *>(a.allocate(a.context,n*sizeof(Use)));
+    job->pins_=static_cast<Mapping *>(a.allocate(a.context,n*sizeof(Mapping)));
+    job->spans_=static_cast<CacheSpan *>(a.allocate(a.context,n*sizeof(CacheSpan)));
+    job->commands_=static_cast<Command *>(a.allocate(a.context,ni*sizeof(Command)));
+    auto fail=[&](Error e) { destroy(job);return e; };
+    if(!job->uses_ || !job->pins_ || !job->spans_ || !job->commands_)return fail(Error::NoMemory);
+    for(size_t i=0;i<n;++i) {
+        const Resource r=resources[i];
+        if(!r.handle || !r.generation || r.reserved || !(r.access&(Read|Write)) ||
+           (r.access&~uint32_t(Read|Write|Execute)) ||
+           ((r.access&Execute) && !(r.access&Read)))return fail(Error::Invalid);
+        Mapping m{};
+        Error error=h.lookup(h.context,r.handle,&m);
+        if(error!=Error::Ok)return fail(error);
+        if(m.owner!=owner)return fail(Error::Ownership);
+        if(m.handle!=r.handle || m.generation!=r.generation || !m.mapping || !m.backing || m.reserved)
+            return fail(Error::Stale);
+        if(!m.bytes || m.iova>UINT64_MAX-m.bytes || m.backing_offset>UINT64_MAX-m.bytes ||
+           !fits(r.offset,r.bytes,m.bytes))return fail(Error::Bounds);
+        if((m.permissions&~uint32_t(Read|Write)) || (r.access&uint32_t(Read|Write)&~m.permissions))
+            return fail(Error::Permission);
+        size_t at=0;
+        for(;at<job->use_count_;++at)if(job->uses_[at].mapping.handle==r.handle)break;
+        if(at<job->use_count_) {
+            Use &u=job->uses_[at];
+            if(!sameMapping(u.mapping,m))return fail(Error::Stale);
+            const uint64_t begin=u.offset<r.offset?u.offset:r.offset;
+            const uint64_t old_end=u.offset+u.bytes,new_end=r.offset+r.bytes;
+            u.offset=begin;u.bytes=(old_end>new_end?old_end:new_end)-begin;u.access|=r.access;
+        } else job->uses_[job->use_count_++]={m,r.offset,r.bytes,r.access,0};
+        size_t pin=0;
+        for(;pin<job->pin_count_;++pin)if(job->pins_[pin].mapping==m.mapping)break;
+        if(pin<job->pin_count_) {
+            if(!sameMapping(job->pins_[pin],m))return fail(Error::Stale);
+        } else job->pins_[job->pin_count_++]=m;
+    }
+    for(size_t i=0;i<ni;++i) {
+        const Ib ib=ibs[i];
+        if(!ib.bytes || (ib.offset&3) || (ib.bytes&3))return fail(Error::Bounds);
+        const Use *use=nullptr;
+        for(size_t j=0;j<job->use_count_;++j)if(job->uses_[j].mapping.handle==ib.handle)use=&job->uses_[j];
+        if(!use || use->mapping.generation!=ib.generation)return fail(Error::Stale);
+        if((use->access&(Read|Execute))!=(Read|Execute))return fail(Error::Permission);
+        if(ib.offset<use->offset || !fits(ib.offset-use->offset,ib.bytes,use->bytes))return fail(Error::Bounds);
+        const uint64_t address=use->mapping.iova+ib.offset;
+        if(address&3)return fail(Error::Bounds);
+        job->commands_[job->command_count_++]={address,ib.bytes};
+    }
+    /* Cache aliases merge by canonical backing ranges; mappings remain separately
+     * pinned. Re-scan after each merge so bridging intervals merge transitively. */
+    for(size_t i=0;i<job->use_count_;++i) {
+        const Use &u=job->uses_[i];
+        CacheSpan span{u.mapping.backing,u.mapping.backing_offset+u.offset,u.bytes,u.access,0};
+        for(size_t j=0;j<job->span_count_;) {
+            CacheSpan &s=job->spans_[j];
+            if(s.backing==span.backing && s.offset<=span.offset+span.bytes && span.offset<=s.offset+s.bytes) {
+                const uint64_t begin=s.offset<span.offset?s.offset:span.offset;
+                const uint64_t end=s.offset+s.bytes>span.offset+span.bytes?s.offset+s.bytes:span.offset+span.bytes;
+                span.offset=begin;span.bytes=end-begin;span.access|=s.access;
+                job->spans_[j]=job->spans_[--job->span_count_];j=0;
+            } else ++j;
+        }
+        job->spans_[job->span_count_++]=span;
+    }
+    *out=job;return Error::Ok;
+}
+Error Job::releaseAll(Release reason) {
+    while(held_) {
+        const Error e=hooks_.release(hooks_.context,pins_[held_-1],reason);
+        if(e!=Error::Ok)return e;
+        --held_;
+    }
+    return Error::Ok;
+}
+Error Job::finishRelease(Release reason,State final_state) {
+    pending_release_=reason;released_state_=final_state;release_pending_=true;
+    const Error e=releaseAll(reason);
+    if(e!=Error::Ok) {state_=State::Uncertain;return e;}
+    release_pending_=false;state_=final_state;return Error::Ok;
+}
+Error Job::submit() {
+    if(state_!=State::Prepared)return Error::Busy;
+    if(hooks_.admit) {
+        const Error e=hooks_.admit(hooks_.context,owner_,queue_);
+        if(e!=Error::Ok) {state_=State::Rejected;return e;}
+    }
+    for(;held_<pin_count_;++held_) {
+        const Error e=hooks_.hold(hooks_.context,pins_[held_]);
+        if(e!=Error::Ok) {
+            const Error release=finishRelease(Release::BeforeSubmit,State::Rejected);
+            return release==Error::Ok?e:release;
+        }
+    }
+    Error e=hooks_.publish(hooks_.context,spans_,span_count_);
+    if(e!=Error::Ok) {
+        const Error release=finishRelease(Release::BeforeSubmit,State::Rejected);
+        return release==Error::Ok?e:release;
+    }
+    const SubmitResult result=hooks_.enqueue(hooks_.context,owner_,queue_,uses_,use_count_,commands_,command_count_);
+    fence_=result.fence;
+    fence_covers_work_=result.acceptance==Acceptance::Accepted && fence_;
+    if(result.acceptance==Acceptance::Rejected && !fence_) {
+        const Error release=finishRelease(Release::BeforeSubmit,State::Rejected);
+        return release!=Error::Ok?release:result.error==Error::Ok?Error::Backend:result.error;
+    }
+    if(result.acceptance==Acceptance::Accepted && fence_ && result.error==Error::Ok) {
+        state_=State::InFlight;return Error::Ok;
+    }
+    state_=State::Uncertain;
+    return result.error==Error::Ok?Error::Backend:result.error;
+}
+Error Job::poll() {
+    if(release_pending_)return finishRelease(pending_release_,released_state_);
+    if(state_==State::Completed)return Error::Ok;
+    if((state_!=State::InFlight && state_!=State::Uncertain) || !fence_covers_work_)return Error::Busy;
+    const Completion c=hooks_.completion(hooks_.context,fence_);
+    if(c!=Completion::Complete) {
+        if(c==Completion::Uncertain)state_=State::Uncertain;
+        return Error::Busy;
+    }
+    /* Even after completion, acquisition failure keeps pins for retry/recovery. */
+    const Error e=hooks_.acquire(hooks_.context,spans_,span_count_);
+    if(e!=Error::Ok) {state_=State::Uncertain;return e;}
+    return finishRelease(Release::Completed,State::Completed);
+}
+Error Job::recover() {
+    if(release_pending_)return finishRelease(pending_release_,released_state_);
+    if(state_!=State::InFlight && state_!=State::Uncertain)return Error::Busy;
+    if(!hooks_.quiesce(hooks_.context))return Error::Busy;
+    const Error e=hooks_.acquire(hooks_.context,spans_,span_count_);
+    if(e!=Error::Ok)return e;
+    return finishRelease(Release::Quiesced,State::Completed);
+}
+Error Job::destroy(Job *job) {
+    if(!job)return Error::Invalid;
+    if(job->held_ || job->state_==State::InFlight || job->state_==State::Uncertain)return Error::Busy;
+    const Allocator a=job->allocator_;
+    if(job->uses_)a.free(a.context,job->uses_,job->resource_capacity_*sizeof(Use));
+    if(job->pins_)a.free(a.context,job->pins_,job->resource_capacity_*sizeof(Mapping));
+    if(job->spans_)a.free(a.context,job->spans_,job->resource_capacity_*sizeof(CacheSpan));
+    if(job->commands_)a.free(a.context,job->commands_,job->command_capacity_*sizeof(Command));
+    job->~Job();a.free(a.context,job,sizeof(Job));return Error::Ok;
+}
+}
