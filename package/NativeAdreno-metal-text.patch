+/* The plugin's text, for a kernel printer (the boot page is off under NOTRACE): the telemetry rows, their sequence, and the report (GPU7)
+ * and report2 lines; with client, the latest client line and the process that sent it. */
+extern "C" const char *native_adreno_metal_text(const char **report,const char **report2,uint32_t *seq)
+{
+    if(report)*report=native_adreno_metal_diag.report;
+    if(report2)*report2=native_adreno_metal_diag.report2;
