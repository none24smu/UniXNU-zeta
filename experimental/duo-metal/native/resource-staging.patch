+        assert(is(h.call(h.request(tx::Operation::Seal)),tx::Status::Ok));
+        assert(!h.f.holds && !h.f.enqueues);
+        assert(h.f.peak_bytes<1024*1024); // Job+upload peak, excluding allocator metadata
+        assert(h.session->submitSealed(99,h.session->token())==nr::Error::Ok);
+        assert(h.f.enqueue_uses==4096 && h.f.enqueue_commands==128 && h.f.holds==4096);
+        h.f.completion=nr::Completion::Complete;assert(h.session->poll()==nr::Error::Ok);h.destroy();++cases;
+    }
+    {
+        Harness h;assert(is(h.begin(),tx::Status::Ok));auto resources=h.f.resources();
+        resources[2].bytes=0;
+        assert(is(h.call(h.resourcePage(resources.data(),3)),tx::Status::BadPacket));
+        assert(h.session->receivedResources()==0 && h.sequence==1);
+        resources=h.f.resources();assert(is(h.call(h.resourcePage(resources.data(),3)),tx::Status::Ok));
+        nr::Ib invalid{1,11,0,3};assert(is(h.call(h.ibPage(&invalid,1)),tx::Status::BadPacket));
+        assert(h.session->receivedIbs()==0 && h.sequence==2);
+        h.destroy();++cases;
+    }
+    for(int change=0;change<7;++change) {
+        Harness h;auto r=h.request(tx::Operation::Begin);uint64_t queue=1;r.payload_bytes=8;
+        std::memcpy(r.payload,&queue,8);
+        switch(change) {
+        case 0:r.total_resources=4097;break;
+        case 1:r.total_ibs=129;break;
+        case 2:r.total_resources=0;break;
+        case 3:r.token=1;break;
+        case 4:r.sequence=1;break;
+        case 5:r.payload[8]=1;break;
+        case 6:r.count=1;break;
+        }
+        assert(is(h.call(r),tx::Status::BadPacket) && h.f.allocations==1);
+        assert(h.session->state()==tx::State::Idle);h.destroy();++cases;
+    }
+    {
+        Harness h;assert(is(h.begin(),tx::Status::Ok));auto r=h.request(tx::Operation::Abort);
+        r.operation=99;assert(is(h.call(r),tx::Status::Unsupported));
+        assert(h.session->state()==tx::State::Uploading && h.sequence==1);
+        assert(is(h.session->process(99,nullptr,408),tx::Status::BadPacket));h.destroy();++cases;
+    }
+    {
+        Harness h;h.sealed();const auto token=h.session->token();
+        auto r=h.request(tx::Operation::Abort);r.payload[351]=1;
+        assert(is(h.call(r),tx::Status::BadPacket) && h.session->state()==tx::State::Sealed);
+        const auto abort=h.request(tx::Operation::Abort);assert(is(h.call(abort),tx::Status::Ok));
+        assert(is(h.call(abort),tx::Status::Stale));
+        assert(h.session->submitSealed(99,token)==nr::Error::Stale && !h.f.enqueues);h.destroy();++cases;
+    }
+    {
+        Harness h(123,true);h.sealed();
+        assert(h.session->submitSealed(99,h.session->token())==nr::Error::Unsupported);
+        assert(!h.f.holds && !h.f.publishes && !h.f.enqueues);
+        assert(h.session->state()==tx::State::Sealed);h.destroy();++cases;
+    }
+    {
+        Harness h;h.sealed();assert(h.session->submitSealed(99,h.session->token())==nr::Error::Ok);
+        h.f.completion=nr::Completion::Complete;h.f.fail_release=2;
+        assert(h.session->poll()==nr::Error::Backend && h.f.releases==1);
+        assert(tx::Session::destroy(h.session)==nr::Error::Busy && h.f.live_allocations);
+        // Closed sessions remain pollable under retained native retirement owner.
+        assert(h.session->poll()==nr::Error::Ok && h.f.releases==3);
+        assert(h.f.acquires==1);h.destroy();++cases;
+    }
+    std::printf("PASS: %zu bounded transaction cases (host callbacks; no IOKit/GPU execution)\n",cases);
+}
