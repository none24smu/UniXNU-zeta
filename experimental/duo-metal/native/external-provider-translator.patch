+//! Real constant folding of the existing exact UNORM8 color-write lowering.
+use super::*;
+use crate::metal::{PixelFormat, PrimitiveTopologyClass};
+use crate::pipeline::descriptor::{ColorAttachmentDescriptor, RenderPipelineDescriptor};
+use crate::pipeline::lower_inputs::ChannelWrite;
+
+/// The result of Metal's exact UNORM8 rounding, as the float its Vulkan attachment stores.
+/// Matches lower::arith::color_write::normalized: exact product rounded to even,
+/// then multiplication by the nearest f32 reciprocal. f64 holds the whole 24+8-bit product.
+pub(crate) fn unorm8_constant(bits: u32) -> u32 {
+    let x = f32::from_bits(bits);
+    let x = if x.is_nan() { 0.0 } else { x.clamp(0.0, 1.0) };
+    let code = (f64::from(x) * 255.0).round_ties_even() as u32;
+    (code as f32 * (1.0f32 / 255.0f32)).to_bits()
+}
+
+fn fold(words: &[u32]) -> Result<Vec<u32>> {
+    let mut scalar = BTreeMap::new();
+    let mut vectors = BTreeMap::new();
+    let mut float = None;
+    let mut vector = None;
+    let mut function = None;
+    let mut store = None;
+    let mut at = 5;
+    while at < words.len() {
+        let count = (words[at] >> 16) as usize;
+        let op = words[at] & 0xffff;
+        let a = &words[at + 1..at + count];
+        match (op, a) {
+            (22, [id, 32]) => float = Some(*id),
+            (23, [id, base, 4]) if Some(*base) == float => vector = Some(*id),
+            (43, [ty, id, bits]) if Some(*ty) == float => {
+                scalar.insert(*id, *bits);
+            }
+            (80, [ty, id, a, b, c, d]) if Some(*ty) == vector => {
+                if let (Some(a), Some(b), Some(c), Some(d)) =
+                    (scalar.get(a), scalar.get(b), scalar.get(c), scalar.get(d))
+                {
+                    vectors.insert(*id, [*a, *b, *c, *d]);
+                }
+            }
+            (54, _) => function = Some(at),
+            (62, [_, value]) => store = Some((at, *value)),
+            _ => {}
+        }
+        at += count;
+    }
+    let (store, value) = store.ok_or(ExternalSpirvError::ColorOutput)?;
+    let rgba = vectors
+        .get(&value)
+        .ok_or(ExternalSpirvError::ColorOutput)?
+        .map(unorm8_constant);
+    let float = float.ok_or(ExternalSpirvError::ColorOutput)?;
+    let vector = vector.ok_or(ExternalSpirvError::ColorOutput)?;
+    let function = function.ok_or(ExternalSpirvError::ColorOutput)?;
+    let first = words[3];
+    if first > 507 || words.len() > 4096 - 23 {
+        return Err(ExternalSpirvError::Bounds);
+    }
+    let mut declarations = Vec::new();
+    for (i, bits) in rgba.iter().enumerate() {
+        declarations.extend([0x0004002b, float, first + i as u32, *bits]);
+    }
+    let mut out = Vec::with_capacity(words.len() + 23);
+    out.extend_from_slice(&words[..function]);
+    out.extend(declarations);
+    out.extend_from_slice(&words[function..store]);
+    out.extend([
+        0x00070050,
+        vector,
+        first + 4,
+        first,
+        first + 1,
+        first + 2,
+        first + 3,
+    ]);
+    out.extend([words[store], words[store + 1], first + 4]);
+    out.extend_from_slice(&words[store + 3..]);
+    out[3] = first + 5;
+    Ok(out)
+}
+
+impl DeviceProfile {
+    /// Import the bounded owned opaque color0 pipeline. RGBA8's exact color-write
+    /// lowering is constant-folded into new SPIR-V; no ColorWrites check is bypassed.
+    /// Only the complete default descriptor with one full-mask RGBA8 attachment,
+    /// triangle topology (or unspecified), no blend/coverage/MSAA/depth is accepted.
+    /// Nonconstant fragment values and every other render contract refuse.
+    pub fn import_resource_free_spirv_for_pipeline(
+        &self,
+        input: &ExternalSpirvStage,
+        d: &RenderPipelineDescriptor,
+    ) -> Result<CompiledFunction> {
+        let mut expected = RenderPipelineDescriptor::new(d.vertex.clone());
+        expected.fragment = d.fragment.clone();
+        expected.color_attachments[0] =
+            Some(ColorAttachmentDescriptor::new(PixelFormat::RGBA8Unorm));
+        if !matches!(
+            d.input_primitive_topology,
+            PrimitiveTopologyClass::Unspecified | PrimitiveTopologyClass::Triangle
+        ) || d.fragment.is_none()
+        {
+            return Err(ExternalSpirvError::RenderContract);
+        }
+        expected.input_primitive_topology = d.input_primitive_topology;
+        if &expected != d {
+            return Err(ExternalSpirvError::RenderContract);
+        }
+        let compiled = self.import_resource_free_spirv(input)?;
+        if input.facts.interface == ExternalStageInterface::VertexIndexPosition {
+            return Ok(compiled);
+        }
+        let exact = crate::pipeline::color_writes::exact_writes(
+            [0],
+            &d.color_attachments,
+            (d.alpha_to_coverage, d.texture_write_rounding_mode),
+            self,
+        );
+        // A real MetalColorWrites profile requires no shader conversion, as the normal linker states.
+        if exact.is_empty() {
+            return Ok(compiled);
+        }
+        if exact.get(&0) != Some(&[Some(ChannelWrite::Unorm { bits: 8 }); 4]) || exact.len() != 1 {
+            return Err(ExternalSpirvError::RenderContract);
+        }
+        let words = fold(&compiled.artifact().module.words)?;
+        let checked = validate(&words, &input.facts)?;
+        let mut artifact = compiled.artifact().clone();
+        artifact.module.words = checked.words;
+        artifact.module.relocs = checked.relocs;
+        artifact.interface.io.color_writes = exact;
+        artifact.interface.io.rounded_colors = vec![0];
+        artifact.strategies.entries.insert(
+            "external.unorm8_constant_fold".into(),
+            StrategyUse { uses: 1, words: 23 },
+        );
+        let mut hash = Sha256::new();
+        hash.update(b"external-unorm8-exact-constant-fold-v1");
+        hash.update(compiled.key().digest());
+        for word in &artifact.module.words {
+            hash.update(word.to_le_bytes());
+        }
+        artifact.key = FunctionCompileKey::new(hash.finalize().into());
+        Ok(CompiledFunction::new(Arc::new(artifact)))
+    }
+}
