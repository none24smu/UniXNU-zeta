+// A listed client's own complaints: the hello's renderer logs "Failed to create textPipeline", "All pipelines failed to load" and the
+// like. With OS_ACTIVITY_DT_MODE in the process's environment (native-exec-env) os_log and NSLog also write to stderr; stderr becomes a
+// pipe here (its write end non-blocking, so a full pipe drops lines and never stalls the process), the lines that name a failure are
+// kept (48 at most), and a sender puts each on the marker stream as "E0 <57 characters>" and "E1 <the next 57>", between the status
+// line's pieces (gStreamLock).
+static pthread_mutex_t gStreamLock = PTHREAD_MUTEX_INITIALIZER;
+static char gComplaints[48][116];
+static std::atomic<unsigned> gComplaintCount;
+static int gStderrPipe = -1;
+static bool complaint(const char *line) {
+    static const char *const words[] = {"fail", "error", "unable", "not available", "refused", "invalid", "pipeline"};
+    for (const char *word : words) if (strcasestr(line, word)) return true;
+    return false;
+}
+static void *readStderr(void *) {
+    static char pending[2048];
+    size_t have = 0;
+    for (;;) {
+        const ssize_t got = read(gStderrPipe, pending + have, sizeof pending - 1 - have);
+        if (got <= 0) return nullptr;
+        have += size_t(got);
+        pending[have] = 0;
+        char *line = pending;
+        for (char *newline; (newline = strchr(line, '\n')); line = newline + 1) {
+            *newline = 0;
+            const char *text = line;
+            if (const char *bracket = strstr(line, "] ")) if (bracket - line < 96) text = bracket + 2;
+            const unsigned slot = gComplaintCount.load();
+            if (slot < 48 && complaint(text)) {
+                strlcpy(gComplaints[slot], text, sizeof gComplaints[slot]);
+                gComplaintCount = slot + 1;
+            }
+        }
+        have = strlen(line);
+        memmove(pending, line, have + 1);
+        if (have == sizeof pending - 1) have = 0; // a line longer than the buffer is dropped
+    }
+}
+static void watchStderr(Gpu *gpu) {
+    if (!getenv("OS_ACTIVITY_DT_MODE")) return;
+    int fds[2];
+    if (pipe(fds) != 0) return;
+    fcntl(fds[1], F_SETFL, fcntl(fds[1], F_GETFL) | O_NONBLOCK);
+    if (dup2(fds[1], STDERR_FILENO) < 0) {close(fds[0]); close(fds[1]); return;}
+    close(fds[1]);
+    gStderrPipe = fds[0];
+    pthread_attr_t attributes;
+    pthread_attr_init(&attributes);
+    pthread_attr_setdetachstate(&attributes, PTHREAD_CREATE_DETACHED);
+    pthread_t thread;
+    pthread_create(&thread, &attributes, readStderr, nullptr);
+    pthread_create(&thread, &attributes, [](void *arg) -> void * {
+        Gpu *g = static_cast<Gpu *>(arg);
+        for (unsigned sent = 0;; ) {
+            sleep(1);
+            while (sent < gComplaintCount.load()) {
+                const char *text = gComplaints[sent++];
+                pthread_mutex_lock(&gStreamLock);
+                const size_t length = strlen(text);
+                for (size_t at = 0, n = 0; at < length && n < 2; at += 57, ++n) {
+                    char piece[64];
+                    snprintf(piece, sizeof piece, "E%zu %.57s", n, text + at);
+                    streamText(*g, piece);
+                    usleep(1500000);
+                }
+                pthread_mutex_unlock(&gStreamLock);
+            }
+        }
+        return nullptr;
+    }, gpu);
+    pthread_attr_destroy(&attributes);
+}
 // A listed client's own frontend status (the render server's comes through its telemetry): when it changed, every five seconds, the
 // status line (counters, then the last two problems) in pieces "C<n> <57 characters>" on the marker stream, which the kernel keeps
 // as the client line. The pieces go 1.5 s apart: the kernel's printer reads the line once a second.
