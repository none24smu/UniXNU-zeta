+        assert(tx::Session::create(99,123,f.caps(),f.allocator(),f.hooks(),&session)==nr::Error::NoMemory);
+        assert(!session && !f.live_allocations);++cases;
+    }
+    for(int phase=0;phase<3;++phase) {
+        Harness h;
+        if(phase==1)assert(is(h.begin(),tx::Status::Ok));
+        if(phase==2)h.sealed();
+        const auto packet=h.request(tx::Operation::Abort);
+        assert(h.session->close()==nr::Error::Ok && h.f.live_allocations==1);
+        assert(is(h.call(packet),tx::Status::Closed) && !h.f.holds && !h.f.enqueues);
+        h.destroy();++cases;
+    }
+    {
+        Harness h;h.sealed();h.f.result={nr::Error::Backend,nr::Acceptance::Uncertain,77};
+        assert(h.session->submitSealed(99,h.session->token())==nr::Error::Backend);
+        assert(h.session->close()==nr::Error::Busy && !h.f.releases);
+        h.f.completion=nr::Completion::Complete;assert(h.session->poll()==nr::Error::Busy);
+        assert(tx::Session::destroy(h.session)==nr::Error::Busy && !h.f.releases);
+        h.f.quiescent=true;assert(h.session->recover()==nr::Error::Ok && h.f.releases==3);
+        h.destroy();++cases;
+    }
+    {
+        Harness h;h.resources=4096;h.ibs=128;h.f.mappings.clear();
