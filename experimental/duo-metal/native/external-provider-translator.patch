+
+impl FieldBytes {
+    /// The most bytes held in place.
+    pub(crate) const INLINE: usize = 32;
+
+    /// `bytes`, copied.
+    pub(crate) fn of(bytes: &[u8]) -> FieldBytes {
+        bytes.iter().copied().collect()
+    }
