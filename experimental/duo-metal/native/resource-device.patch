index 0000000..fc0bf0d
--- /dev/null
+++ b/tests/compile-resource-client-xnu.py
@@ -0,0 +1,198 @@
+#!/usr/bin/env python3
+"""Compile isolated resource units with an existing real XNU C++ build record.
+
+Run on the original build host after XNU generated its headers. Does not alter
+provider feeds, archives, selected profiles or phone images. Object compilation
+alone is not final-link, native execution or ABI qualification.
+"""
+import argparse
+import hashlib
+import json
+import os
+import shutil
+from pathlib import Path
+import re
+import struct
+import subprocess
+
+UNITS = ('NativeAdrenoPublish', 'NativeAdrenoUserClient', 'NativeAdrenoVm',
+         'NativeAdrenoResources', 'NativeAdrenoResourceTransaction',
+         'NativeAdrenoMemory', 'NativeAdrenoResourceQueue')
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def command_from_record(record, source, output):
+    cwd = Path(record['directory']).resolve()
+    original = Path(record['file'])
+    original = original.resolve() if original.is_absolute() else (cwd / original).resolve()
+    args = record['arguments']
+    result, index, replaced, outputs = [], 0, 0, 0
+    while index < len(args):
+        value = args[index]
+        candidate = Path(value)
+        if not value.startswith('-') and index and (
+                candidate.resolve() if candidate.is_absolute() else (cwd / candidate).resolve()) == original:
+            result.append(str(source.resolve()))
+            replaced += 1
+        elif value == '-o':
+            if index + 1 >= len(args):
+                raise ValueError('missing -o operand')
+            result.extend(['-o', str(output.resolve())])
+            outputs += 1
+            index += 1
+        elif value in ('-MF', '-MJ', '-MT', '-MQ'):
+            if index + 1 >= len(args):
+                raise ValueError('missing dependency operand')
+            index += 1
+        elif value not in ('-MD', '-MMD', '-MP'):
+            result.append(value)
+        index += 1
+    if replaced != 1 or outputs != 1 or '-c' not in result:
+        raise ValueError('expected one compile source and one object output')
+    return result
+
+
+def header_provenance(log, allowed, directory):
+    headers = {}
+    for line in log.splitlines():
+        found = re.match(r'^\.+ (.+?)(?: \(.*\))?$', line)
+        if not found:
+            continue
+        path = Path(found.group(1))
+        if path.name not in ('IOLib.h', 'IOUserClient.h', 'OSObject.h', 'IOMemoryDescriptor.h'):
+            continue
+        path = path if path.is_absolute() else Path(directory) / path
+        path = path.resolve(strict=True)
+        if not any(path.is_relative_to(root) for root in allowed):
+            raise ValueError('IOKit/libkern header outside declared real roots: ' + str(path))
+        headers[str(path)] = sha(path)
+    return headers
+
+
+def retain_header_snapshot(log, directory, output, snapshot):
+    """Retain actual traced bytes before checking success, including generated IIG.
+
+    Relative -H paths belong to the compiler record cwd, never this script's cwd.
+    Preserve lookup spellings as ordinary files; do not retain dangling symlinks.
+    This closure is evidence, not a qualified relocatable SDK until replayed.
+    """
+    for line in log.splitlines():
+        found = re.match(r'^\.+ (.+?)(?: \(.*\))?$', line)
+        if not found:
+            continue
+        source = Path(found.group(1))
+        if not source.is_absolute():
+            source = Path(directory) / source
+        source = Path(os.path.abspath(source))
+        if not source.is_file():
+            continue
+        destination = output / 'files' / str(source).lstrip('/')
+        destination.parent.mkdir(parents=True, exist_ok=True)
+        shutil.copyfile(source, destination)
+        snapshot['headers'][str(source)] = sha(destination)
+    # These frontend inputs are not headers and therefore do not appear in -H.
+    # Capture the exact current XNU sanitizer list rather than silently dropping
+    # its flags in a later compile-only replay.
+    auxiliary = snapshot.setdefault('auxiliary', {})
+    for argument in snapshot['record']['arguments']:
+        if not argument.startswith('-fsanitize-ignorelist='):
+            continue
+        source = Path(argument.split('=', 1)[1])
+        if not source.is_absolute():
+            source = Path(directory) / source
+        source = Path(os.path.abspath(source))
+        destination = output / 'files' / str(source).lstrip('/')
+        destination.parent.mkdir(parents=True, exist_ok=True)
+        shutil.copyfile(source, destination)
+        auxiliary[str(source)] = sha(destination)
+    # Retain the complete declared kit closure, including headers not yet
+    # traced when an earlier object fails. Hashes alone cannot replay bytes.
+    for name, digest in snapshot.get('kit_header_sha256', {}).items():
+        source = Path(snapshot['kit_header_source_root']) / name
+        if sha(source) != digest:
+            raise ValueError('native kit changed while retaining SDK snapshot')
+        destination = output / 'files' / str(source).lstrip('/')
+        destination.parent.mkdir(parents=True, exist_ok=True)
+        shutil.copyfile(source, destination)
+        auxiliary[str(source)] = digest
+    # Clang -H can omit forced preincludes (or PCH-provided configuration).
+    # Capture the real generated configuration header directory explicitly.
+    for source in sorted(Path(directory).glob('*.h')):
+        destination = output / 'files' / str(source).lstrip('/')
+        destination.parent.mkdir(parents=True, exist_ok=True)
+        shutil.copyfile(source, destination)
+        auxiliary[str(source)] = sha(destination)
+    output.mkdir(parents=True, exist_ok=True)
+    (output / 'manifest.json').write_text(json.dumps(snapshot, indent=2) + '\n')
+
+
+def main():
+    root = Path(__file__).resolve().parents[1]
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--record', type=Path, required=True,
+                   help='actual IOPlatformExpert.cpo.json from same XNU configuration')
+    p.add_argument('--unixnu', type=Path, required=True)
+    p.add_argument('--header-root', type=Path, action='append', required=True,
+                   help='real XNU source/generated SDK root; repeat as needed')
+    p.add_argument('--output', type=Path, required=True)
+    a = p.parse_args()
+    record = json.loads(a.record.read_text().strip().rstrip(','))
+    if not Path(record['directory']).is_dir():
+        p.error('original compile working directory is unavailable')
+    allowed = [path.resolve(strict=True) for path in a.header_root]
+    output = a.output.resolve()
+    output.mkdir(parents=True, exist_ok=True)
+    manifest = dict(scope='real XNU C++ compile-record object check; no linking or execution proof',
+                    record_sha256=sha(a.record), record=record, headers={}, objects=[],
+                    native_publish_compiled=False, staging_default_changed=False,
+                    profile_selected=False, passed=False)
+    result_path = output / 'xnu-objects.json'
+    snapshot = dict(scope='exact compiler-traced header closure; replay not yet qualified',
+                    record=record, headers={}, compiler_sha256=sha(Path(record['arguments'][0])),
+                    compiler_resource_dir=subprocess.check_output(
+                        [record['arguments'][0], '-print-resource-dir'], text=True).strip(),
+                    relocatable_sdk_qualified=False,
+                    kit_header_source_root=str(a.unixnu.resolve()),
+                    kit_header_sha256={str(path.relative_to(a.unixnu.resolve())):sha(path)
+                        for kit in ('ArmSmmu4K','AdrenoPM4','AdrenoFirmware')
+                        for path in sorted((a.unixnu.resolve()/'kits'/kit).glob('*.h'))})
+    for staging in (0, 1):
+        for unit in UNITS:
+            source = root / (unit + '.cpp')
+            obj = output / f'{unit}-staging{staging}.o'
+            cmd = command_from_record(record, source, obj)
+            cmd += ['-std=c++23', '-H', '-UNATIVE_ADRENO_EXPERIMENTAL_RESOURCE_STAGING',
+                    f'-DNATIVE_ADRENO_EXPERIMENTAL_RESOURCE_STAGING={staging}']
+            for include in (root, a.unixnu / 'kits/ArmSmmu4K', a.unixnu / 'kits/AdrenoPM4',
+                            a.unixnu / 'kits/AdrenoFirmware'):
+                cmd += ['-I', str(include.resolve())]
+            run = subprocess.run(cmd, cwd=record['directory'], capture_output=True, text=True, timeout=300)
+            log = run.stdout + run.stderr
+            (output / f'{unit}-staging{staging}.log').write_text(log)
+            retain_header_snapshot(log, record['directory'], output / 'header-snapshot', snapshot)
+            entry = dict(source=source.name, source_sha256=sha(source), staging=staging,
+                         command=cmd, returncode=run.returncode)
+            manifest['objects'].append(entry)
+            result_path.write_text(json.dumps(manifest, indent=2) + '\n')
+            if run.returncode:
+                raise RuntimeError('real XNU compile failed; retained log: ' + str(output / f'{unit}-staging{staging}.log'))
+            raw = obj.read_bytes()
+            if len(raw) < 32 or struct.unpack_from('<4I', raw) != (0xfeedfacf, 0x100000c, 0, 1):
+                raise ValueError('expected plain ARM64 Mach-O object: ' + str(obj))
+            headers = header_provenance(log, allowed, record['directory'])
+            if unit == 'NativeAdrenoPublish' and not {'IOLib.h', 'IOUserClient.h', 'OSObject.h',
+                                                       'IOMemoryDescriptor.h'} <= {Path(h).name for h in headers}:
+                raise ValueError('missing actual IOKit wrapper header trace')
+            manifest['headers'].update(headers)
+            entry['sha256'] = sha(obj)
+    manifest['native_publish_compiled'] = True
+    manifest['passed'] = True
+    result_path.write_text(json.dumps(manifest, indent=2) + '\n')
+    print('PASS: 14 real XNU-header ARM64 objects; no linking, execution or selected profile')
+
+
+if __name__ == '__main__':
+    main()
