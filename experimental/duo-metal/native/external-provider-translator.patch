+//! Checked import of a bounded resource-free external SPIR-V stage.
+//!
+//! The first contract is deliberately small: straight-line 32-bit vertex-index
+//! to position, or a resource-free vec4 float color0 fragment. Unknown resources,
+//! specialization, attributes, interfaces and instructions are typed refusals.
+//! Existing AIR compilation is unchanged. Imported words become an ordinary
+//! `CompiledFunction`, so the existing linker, planner and consumer remain in use.
+
+use std::collections::{BTreeMap, BTreeSet};
+use std::fmt;
+use std::sync::Arc;
+
+use sha2::{Digest, Sha256};
+
+use crate::cache::Hash256;
+use crate::device::requirements::{ApiVersion, Requirements, SpirvCapability};
+use crate::device::subgroup::SubgroupRequirement;
+use crate::device::DeviceProfile;
+use crate::library::compiled::{FunctionArtifact, KernelFacts};
+use crate::library::{CompiledFunction, FunctionCompileKey};
+use crate::pipeline::artifact::{Reconvergence, StrategyCensus, StrategyUse};
+use crate::pipeline::interface::{PushPlacement, StageInterface};
+use crate::pipeline::stage_io::{IoNumeric, IoRole, IoType, IoVariable, StageBuiltin, StageIo};
+use crate::pipeline::sym::{Stage, Symbol, VaryingKey};
+use crate::spirv::serialize::RelocatableModule;
+
+/// The complete interface accepted by this importer, never a caller-provided binding plan.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ExternalStageInterface {
+    /// One uint VertexIndex input and one vec4 f32 Position output.
+    VertexIndexPosition,
+    /// No inputs, one vec4 f32 output at color0/index0, OriginUpperLeft.
+    FragmentColor0,
+}
+
+/// Immutable provenance and the interface the producer declares.
+#[derive(Clone, Debug)]
+pub struct ExternalStageFacts {
+    pub stage: Stage,
+    pub interface: ExternalStageInterface,
+    pub entry_point: String,
+    pub profile: Hash256,
+    pub source_air_sha256: Hash256,
+    pub compiler_sha256: Hash256,
+    pub spirv_sha256: Hash256,
+}
+
+/// A copied, immutable external stage. Construction alone grants no trust.
+#[derive(Clone, Debug)]
+pub struct ExternalSpirvStage {
+    words: Arc<[u32]>,
+    facts: ExternalStageFacts,
+}
+
+impl ExternalSpirvStage {
+    pub fn new(words: Vec<u32>, facts: ExternalStageFacts) -> Self {
+        Self {
+            words: words.into(),
+            facts,
+        }
+    }
+}
+
+/// A bounded import refusal; malformed modules never enter the linker.
+#[non_exhaustive]
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum ExternalSpirvError {
+    Bounds,
+    Profile,
+    Digest,
+    Interface,
+    Resources,
+    Specialization,
+    RenderContract,
+    ColorOutput,
+    Instruction(u16),
+    Invalid(&'static str),
+}
+impl fmt::Display for ExternalSpirvError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "external resource-free SPIR-V: {self:?}")
+    }
+}
+impl std::error::Error for ExternalSpirvError {}
+type Result<T> = std::result::Result<T, ExternalSpirvError>;
+fn invalid(why: &'static str) -> ExternalSpirvError {
+    ExternalSpirvError::Invalid(why)
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord)]
+enum Ty {
+    Void,
+    Bool,
+    Int(bool),
+    Float,
+    Vector(u32, u32),
+    Pointer(u32, u32),
+    Function(u32),
+}
+#[derive(Clone, Copy, Debug)]
+enum Def {
+    Type(Ty),
+    Value(u32),
+    Global(u32, u32),
+    Import,
+    Function,
+    Label,
+}
+#[derive(Clone, Debug, Default)]
+struct Decorations {
+    builtin: Option<u32>,
+    location: Option<(u32, u32)>,
+    index: Option<u32>,
+}
+struct Checked {
+    words: Vec<u32>,
+    relocs: Vec<(Symbol, u32)>,
+}
+struct Validator {
+    defs: BTreeMap<u32, Def>,
+    types: BTreeSet<Ty>,
+    decorations: BTreeMap<u32, Decorations>,
+    globals: BTreeSet<u32>,
+    stored: BTreeSet<u32>,
+    names: Vec<u32>,
+    bound: u32,
+}
+impl Validator {
+    fn define(&mut self, id: u32, def: Def) -> Result<()> {
+        if id == 0 || id >= self.bound || self.defs.insert(id, def).is_some() {
+            return Err(invalid("duplicate/out-of-bound id"));
+        }
+        Ok(())
+    }
+    fn ty(&self, id: u32) -> Result<Ty> {
+        match self.defs.get(&id) {
+            Some(Def::Type(t)) => Ok(*t),
+            _ => Err(invalid("undefined type")),
+        }
+    }
+    fn value(&self, id: u32) -> Result<u32> {
+        match self.defs.get(&id) {
+            Some(Def::Value(t)) => Ok(*t),
+            _ => Err(invalid("undefined numeric value")),
+        }
+    }
+    fn numeric(&self, id: u32) -> Result<bool> {
+        Ok(matches!(self.ty(id)?, Ty::Int(_) | Ty::Float))
+    }
+    fn add_type(&mut self, id: u32, ty: Ty) -> Result<()> {
+        if !self.types.insert(ty) {
+            return Err(invalid("duplicate type"));
+        }
+        self.define(id, Def::Type(ty))
+    }
+}
+fn string(words: &[u32]) -> Result<(String, usize)> {
+    let mut bytes = Vec::new();
+    for (index, word) in words.iter().enumerate() {
+        let encoded = word.to_le_bytes();
+        for (at, byte) in encoded.iter().enumerate() {
+            if *byte == 0 {
+                if encoded.iter().skip(at + 1).any(|b| *b != 0) {
+                    return Err(invalid("string padding"));
+                }
+                return Ok((
+                    String::from_utf8(bytes).map_err(|_| invalid("string UTF8"))?,
+                    index + 1,
+                ));
+            }
+            if bytes.len() >= 127 {
+                return Err(ExternalSpirvError::Bounds);
+            }
+            bytes.push(*byte);
+        }
+    }
+    Err(invalid("unterminated string"))
+}
+fn validate(words: &[u32], facts: &ExternalStageFacts) -> Result<Checked> {
+    let [magic, version, _generator, bound, schema, ..] = words else {
+        return Err(ExternalSpirvError::Bounds);
+    };
+    if words.len() > 4096 || *bound == 0 || *bound > 512 {
+        return Err(ExternalSpirvError::Bounds);
+    }
+    if *magic != 0x07230203 || *version != 0x00010500 || *schema != 0 {
+        return Err(invalid("header/version"));
+    }
+    let vertex = facts.interface == ExternalStageInterface::VertexIndexPosition;
+    if facts.entry_point != "main"
+        || facts.stage
+            != if vertex {
+                Stage::Vertex
+            } else {
+                Stage::Fragment
+            }
+    {
+        return Err(ExternalSpirvError::Interface);
+    }
+    let mut v = Validator {
+        defs: BTreeMap::new(),
+        types: BTreeSet::new(),
+        decorations: BTreeMap::new(),
+        globals: BTreeSet::new(),
+        stored: BTreeSet::new(),
+        names: Vec::new(),
+        bound: *bound,
+    };
+    let mut at = 5;
+    let mut rank = 0;
+    let mut capability = false;
+    let mut memory = false;
+    let mut entry = None;
+    let mut interface = BTreeSet::new();
+    let mut origin = false;
+    let mut function = false;
+    let mut ended = false;
+    let mut block = false;
+    let mut terminal = false;
+    let mut next_label = None;
+    let mut returned = false;
+    while at < words.len() {
+        let header = *words.get(at).ok_or(ExternalSpirvError::Bounds)?;
+        let count = (header >> 16) as usize;
+        let op = (header & 0xffff) as u16;
+        if count == 0 || count > words.len() - at {
+            return Err(ExternalSpirvError::Bounds);
+        }
+        let a = words
+            .get(at + 1..at + count)
+            .ok_or(ExternalSpirvError::Bounds)?;
+        let current = match op {
+            17 => 0,
+            11 => 1,
+            14 => 2,
+            15 => 3,
+            16 => 4,
+            3 | 5 => 5,
+            71 => 6,
+            19 | 20 | 21 | 22 | 23 | 32 | 33 | 41 | 42 | 43 | 59 => 7,
+            _ => 8,
+        };
+        if current < rank || ended {
+            return Err(invalid("logical instruction order"));
+        }
+        rank = current;
+        match (op, a) {
+            (17, [1]) if !capability => capability = true,
+            (11, [id, rest @ ..]) => {
+                let (name, n) = string(rest)?;
+                if name != "GLSL.std.450" || n != rest.len() {
+                    return Err(ExternalSpirvError::Instruction(op));
+                }
+                v.define(*id, Def::Import)?;
+            }
+            (14, [0, 1]) if !memory => memory = true,
+            (15, [model, id, rest @ ..]) if entry.is_none() => {
+                let (name, n) = string(rest)?;
+                if *model != if vertex { 0 } else { 4 }
+                    || name != facts.entry_point
+                    || *id == 0
+                    || *id >= *bound
+                {
+                    return Err(ExternalSpirvError::Interface);
+                }
+                entry = Some(*id);
+                for value in rest.iter().skip(n) {
+                    if !interface.insert(*value) {
+                        return Err(invalid("duplicate entry interface"));
+                    }
+                }
+            }
+            (16, [id, 7]) if !vertex && Some(*id) == entry && !origin => origin = true,
+            (3, [0, 0]) => {}
+            (5, [id, rest @ ..]) => {
+                let (_, n) = string(rest)?;
+                if n != rest.len() {
+                    return Err(invalid("name operands"));
+                }
+                v.names.push(*id);
+            }
+            (71, [id, decoration, value]) => {
+                if *id == 0 || *id >= *bound {
+                    return Err(ExternalSpirvError::Bounds);
+                }
+                let d = v.decorations.entry(*id).or_default();
+                match *decoration {
+                    11 if d.builtin.is_none() => d.builtin = Some(*value),
+                    30 if d.location.is_none() => d.location = Some((*value, (at + 3) as u32)),
+                    32 if d.index.is_none() => d.index = Some(*value),
+                    1 => return Err(ExternalSpirvError::Specialization),
+                    33 | 34 => return Err(ExternalSpirvError::Resources),
+                    _ => return Err(ExternalSpirvError::Interface),
+                }
+            }
+            (19, [id]) => v.add_type(*id, Ty::Void)?,
+            (20, [id]) => v.add_type(*id, Ty::Bool)?,
+            (21, [id, 32, sign]) if *sign <= 1 => v.add_type(*id, Ty::Int(*sign == 1))?,
+            (22, [id, 32]) => v.add_type(*id, Ty::Float)?,
+            (23, [id, base, n]) if (2..=4).contains(n) && v.numeric(*base)? => {
+                v.add_type(*id, Ty::Vector(*base, *n))?
+            }
+            (32, [id, storage, pointee]) if matches!(*storage, 1 | 3) => {
+                if !matches!(v.ty(*pointee)?, Ty::Int(_) | Ty::Float | Ty::Vector(_, _)) {
+                    return Err(ExternalSpirvError::Interface);
+                }
+                v.add_type(*id, Ty::Pointer(*storage, *pointee))?;
+            }
+            (33, [id, ret]) if v.ty(*ret)? == Ty::Void => v.add_type(*id, Ty::Function(*ret))?,
+            (41 | 42, [ty, id]) if v.ty(*ty)? == Ty::Bool => v.define(*id, Def::Value(*ty))?,
+            (43, [ty, id, _]) if v.numeric(*ty)? => v.define(*id, Def::Value(*ty))?,
+            (59, [ty, id, storage]) => {
+                if !matches!(*storage, 1 | 3) {
+                    return Err(ExternalSpirvError::Resources);
+                }
+                if !matches!(v.ty(*ty)?,Ty::Pointer(s,_) if s==*storage) {
+                    return Err(invalid("variable pointer type"));
+                }
+                v.define(*id, Def::Global(*ty, *storage))?;
+                v.globals.insert(*id);
+            }
+            (54, [ret, id, 0, signature])
+                if !function
+                    && Some(*id) == entry
+                    && v.ty(*ret)? == Ty::Void
+                    && v.ty(*signature)? == Ty::Function(*ret) =>
+            {
+                v.define(*id, Def::Function)?;
+                function = true;
+            }
+            (248, [id]) if function && (!block || terminal) && !returned => {
+                if let Some(expected) = next_label.take() {
+                    if *id != expected {
+                        return Err(invalid("branch target/linear CFG"));
+                    }
+                } else if block {
+                    return Err(invalid("unreachable block"));
+                }
+                v.define(*id, Def::Label)?;
+                block = true;
+                terminal = false;
+            }
+            (61, [ty, id, pointer]) if block && !terminal => {
+                let Some(Def::Global(ptr, 1)) = v.defs.get(pointer) else {
+                    return Err(invalid("load source"));
+                };
+                if v.ty(*ptr)? != Ty::Pointer(1, *ty) {
+                    return Err(invalid("load type"));
+                }
+                v.define(*id, Def::Value(*ty))?;
+            }
+            (62, [pointer, value]) if block && !terminal => {
+                let Some(Def::Global(ptr, 3)) = v.defs.get(pointer) else {
+                    return Err(invalid("store destination"));
+                };
+                if v.ty(*ptr)? != Ty::Pointer(3, v.value(*value)?) {
+                    return Err(invalid("store type"));
+                }
+                if !v.stored.insert(*pointer) {
+                    return Err(invalid("repeated output store"));
+                }
+            }
+            (80, [ty, id, values @ ..]) if block && !terminal => {
+                let Ty::Vector(base, n) = v.ty(*ty)? else {
+                    return Err(invalid("composite type"));
+                };
+                if values.len() != n as usize
+                    || values.iter().any(|id| v.value(*id).ok() != Some(base))
+                {
+                    return Err(invalid("composite operands"));
+                }
+                v.define(*id, Def::Value(*ty))?;
+            }
+            (124, [ty, id, value]) if block && !terminal => {
+                if !v.numeric(*ty)? || !v.numeric(v.value(*value)?)? {
+                    return Err(invalid("bitcast type"));
+                }
+                v.define(*id, Def::Value(*ty))?;
+            }
+            (170, [ty, id, left, right]) if block && !terminal => {
+                let lt = v.value(*left)?;
+                if v.ty(*ty)? != Ty::Bool
+                    || !matches!(v.ty(lt)?, Ty::Int(_))
+                    || v.value(*right)? != lt
+                {
+                    return Err(invalid("integer equality type"));
+                }
+                v.define(*id, Def::Value(*ty))?;
+            }
+            (169, [ty, id, condition, yes, no]) if block && !terminal => {
+                if !v.numeric(*ty)?
+                    || v.ty(v.value(*condition)?)? != Ty::Bool
+                    || v.value(*yes)? != *ty
+                    || v.value(*no)? != *ty
+                {
+                    return Err(invalid("select type"));
+                }
+                v.define(*id, Def::Value(*ty))?;
+            }
+            (249, [target]) if block && !terminal => {
+                if *target == 0 || *target >= *bound || v.defs.contains_key(target) {
+                    return Err(invalid("backwards/invalid branch"));
+                }
+                terminal = true;
+                next_label = Some(*target);
+            }
+            (253, []) if block && !terminal => {
+                terminal = true;
+                returned = true;
+            }
+            (56, []) if function && terminal && returned && next_label.is_none() => ended = true,
+            (48..=52, _) => return Err(ExternalSpirvError::Specialization),
+            (25..=29, _) => return Err(ExternalSpirvError::Resources),
+            _ => return Err(ExternalSpirvError::Instruction(op)),
+        }
+        at += count;
+    }
+    if !capability
+        || !memory
+        || !ended
+        || (!vertex && !origin)
+        || interface != v.globals
+        || v.names.iter().any(|id| !v.defs.contains_key(id))
+    {
+        return Err(invalid("module completeness"));
+    }
+    if v.decorations.keys().any(|id| !v.globals.contains(id)) {
+        return Err(ExternalSpirvError::Interface);
+    }
+    let mut inputs = 0;
+    let mut outputs = 0;
+    let mut relocs = Vec::new();
+    for id in &v.globals {
+        let Some(Def::Global(pointer, storage)) = v.defs.get(id) else {
+            return Err(invalid("global definition"));
+        };
+        let Ty::Pointer(_, pointee) = v.ty(*pointer)? else {
+            return Err(invalid("global pointer"));
+        };
+        let d = v.decorations.get(id).ok_or(ExternalSpirvError::Interface)?;
+        let vec4 = matches!(v.ty(pointee)?,Ty::Vector(base,4) if v.ty(base).ok()==Some(Ty::Float));
+        match (*storage, vertex) {
+            (1, true)
+                if v.ty(pointee)? == Ty::Int(false)
+                    && d.builtin == Some(42)
+                    && d.location.is_none()
+                    && d.index.is_none() =>
+            {
+                inputs += 1
+            }
+            (3, true)
+                if vec4 && d.builtin == Some(0) && d.location.is_none() && d.index.is_none() =>
+            {
+                outputs += 1
+            }
+            (3, false)
+                if vec4
+                    && d.builtin.is_none()
+                    && matches!(d.location, Some((0, _)))
+                    && d.index == Some(0) =>
+            {
+                outputs += 1;
+                let (_, offset) = d.location.ok_or(ExternalSpirvError::Interface)?;
+                relocs.push((Symbol::Location(VaryingKey::color(0, 0)), offset));
+            }
+            _ => return Err(ExternalSpirvError::Interface),
+        }
+    }
+    if inputs != usize::from(vertex) || outputs != 1 || v.stored.len() != 1 {
+        return Err(ExternalSpirvError::Interface);
+    }
+    Ok(Checked {
+        words: words.to_vec(),
+        relocs,
+    })
+}
+
+impl DeviceProfile {
+    /// Import a bounded external stage only after validating words, interface,
+    /// profile and immutable source/compiler identities. This is not a general
+    /// SPIR-V importer. The normal linker still checks attachment/vertex inputs.
+    pub fn import_resource_free_spirv(
+        &self,
+        input: &ExternalSpirvStage,
+    ) -> Result<CompiledFunction> {
+        if input.words.len() > 4096 {
+            return Err(ExternalSpirvError::Bounds);
+        }
+        let facts = &input.facts;
+        if facts.profile != self.fingerprint() {
+            return Err(ExternalSpirvError::Profile);
+        }
+        let mut digest = Sha256::new();
+        for word in input.words.iter() {
+            digest.update(word.to_le_bytes());
+        }
+        let actual: Hash256 = digest.finalize().into();
+        if actual != facts.spirv_sha256
+            || facts.compiler_sha256 == [0; 32]
+            || facts.source_air_sha256 == [0; 32]
+        {
+            return Err(ExternalSpirvError::Digest);
+        }
+        let checked = validate(&input.words, facts)?;
+        let mut requirements = Requirements {
+            api_version: Some(ApiVersion::V1_2),
+            ..Requirements::default()
+        };
+        requirements
+            .spirv_capabilities
+            .insert(SpirvCapability::from_raw(1));
+        self.check(&requirements)
+            .map_err(|_| ExternalSpirvError::Profile)?;
+        let mut io = StageIo::default();
+        match facts.interface {
+            ExternalStageInterface::VertexIndexPosition => {
+                io.builtins = vec![
+                    StageBuiltin::VertexIndex,
+                    StageBuiltin::Position { invariant: false },
+                ]
+            }
+            ExternalStageInterface::FragmentColor0 => io.outputs.push(IoVariable {
+                key: VaryingKey::color(0, 0),
+                role: IoRole::Color {
+                    attachment: 0,
+                    index: 0,
+                },
+                ty: IoType {
+                    numeric: IoNumeric::Float,
+                    components: 4,
+                    source_bits: 32,
+                    bits: 32,
+                },
+            }),
+        }
+        let interface = StageInterface {
+            stage: facts.stage,
+            slots: BTreeMap::new(),
+            threadgroup: Vec::new(),
+            push: PushPlacement {
+                stage: facts.stage,
+                fields: Vec::new(),
+                push_range: None,
+                argument_table_size: 0,
+            },
+            descriptors: Vec::new(),
+            spec: Vec::new(),
+            needs_pointer_translation: false,
+            needs_handle_translation: false,
+            io,
+            tessellation: None,
+            writes_memory: false,
+            mesh_records: None,
+            emulated_payload: None,
+            reaches_command_buffers: false,
+            writes_textures: false,
+            numbered_samplers: Vec::new(),
+        };
+        let mut hash = Sha256::new();
+        hash.update(b"external-resource-free-spirv-v1");
+        hash.update(crate::cache::SEMANTICS_VERSION.to_le_bytes());
+        hash.update(facts.profile);
+        hash.update(facts.source_air_sha256);
+        hash.update(facts.compiler_sha256);
+        hash.update(actual);
+        hash.update([u8::from(facts.stage == Stage::Fragment)]);
+        let key: Hash256 = hash.finalize().into();
+        let mut strategies = StrategyCensus::default();
+        strategies.entries.insert(
+            "external.resource_free_spirv".into(),
+            StrategyUse {
+                uses: 1,
+                words: checked.words.len() as u64,
+            },
+        );
+        Ok(CompiledFunction::new(Arc::new(FunctionArtifact {
+            key: FunctionCompileKey::new(key),
+            module: RelocatableModule {
+                words: checked.words,
+                relocs: checked.relocs,
+                requirements: requirements.clone(),
+            },
+            interface,
+            facts: Vec::new(),
+            subgroup: SubgroupRequirement::NONE,
+            reconvergence: Reconvergence::Guaranteed,
+            precision: Vec::new(),
+            strategies,
+            blob: None,
+            requirements,
+            variant_bits: 0,
+            profile: facts.profile,
+            kernel: KernelFacts::default(),
+            reflection: Some(crate::reflection::StageReflection {
+                bindings: Vec::new(),
+                attributes: BTreeSet::new(),
+            }),
+            specialized: Vec::new(),
+        })))
+    }
+}
