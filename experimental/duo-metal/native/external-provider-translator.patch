@@ -58,6 +58,70 @@ pub struct UsedResources {
     pub heaps: Vec<Heap>,
 }
 
+// Compare host address ranges without touching their bytes. Object identity covers private
+// memory; host ranges additionally cover distinct imports of an IOSurface or overlapping
+// no-copy buffers. Unknown arithmetic is conservative. Rebinding is not performed by this
+// consumer, and callers must not remap these ranges while the resources are in use.
+fn buffers_overlap(a: &Buffer, b: &Buffer) -> bool {
+    if a == b {
+        return true;
+    }
+    let (Some(a_start), Some(b_start)) = (a.contents(), b.contents()) else {
+        return false;
+    };
+    let (Ok(a_len), Ok(b_len)) = (usize::try_from(a.length()), usize::try_from(b.length())) else {
+        return true;
+    };
+    let a_start = a_start.as_ptr() as usize;
+    let b_start = b_start.as_ptr() as usize;
+    let (Some(a_end), Some(b_end)) = (a_start.checked_add(a_len), b_start.checked_add(b_len))
+    else {
+        return true;
+    };
+    a_start < b_end && b_start < a_end
+}
+
+impl UsedResources {
+    fn references_buffer(&self, buffer: &Buffer) -> bool {
+        if buffer.heap().is_some_and(|heap| self.heaps.contains(heap)) {
+            return true;
+        }
+        self.buffers
+            .iter()
+            .any(|other| buffers_overlap(buffer, other))
+            || self.heaps.iter().any(|heap| {
+                heap.bytes()
+                    .is_some_and(|bytes| buffers_overlap(buffer, bytes))
+            })
+    }
+
+    /// Whether this list names a resource's storage, including a view's root, a buffer
+    /// texture's backing buffer, a heap's resources and overlapping imported host ranges.
+    /// A caller may skip waiting only while this is false. This consumer does not rebind
+    /// or remap live backing ranges. Indirect command buffers remain conservative.
+    pub fn references_resource(&self, resource: super::resource::ResourceRef<'_>) -> bool {
+        use super::resource::ResourceRef;
+        match resource {
+            ResourceRef::Buffer(buffer) => self.references_buffer(buffer),
+            ResourceRef::Texture(texture) => match texture.memory() {
+                TextureMemory::Heap(heap) => self.references_heap(heap),
+                TextureMemory::Buffer(buffer) => self.references_buffer(buffer),
+                TextureMemory::Own(root) => self.textures.contains(root),
+            },
+            ResourceRef::IndirectCommandBuffer(_) => true,
+        }
+    }
+
+    /// Heap storage is treated as one dependency, conservatively including its disjoint
+    /// members. Imports over its host range are dependencies too.
+    pub fn references_heap(&self, heap: &Heap) -> bool {
+        self.heaps.contains(heap)
+            || heap
+                .bytes()
+                .is_some_and(|bytes| self.references_buffer(bytes))
+    }
+}
