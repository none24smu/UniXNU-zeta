new file mode 100644
index 0000000..ec9f782
--- /dev/null
+++ b/NativeAdrenoResourceQueue.cpp
@@ -0,0 +1,132 @@
+/* SPDX-License-Identifier: MIT */
+#include "NativeAdrenoResourceQueue.h"
+#include "AdrenoPM4.h"
+namespace nr=NativeAdrenoResources;
+namespace {
+nr::Error convert(IOReturn status) {
+    if(status==kIOReturnSuccess)return nr::Error::Ok;
+    if(status==kIOReturnBusy)return nr::Error::Busy;
+    if(status==kIOReturnBadArgument)return nr::Error::Stale;
+    if(status==kIOReturnUnsupported)return nr::Error::Unsupported;
+    return nr::Error::Backend;
+}
+bool same(const nr::Mapping &a,const nr::Mapping &b) {
+    return a.handle==b.handle && a.generation==b.generation && a.owner==b.owner &&
+        a.backing==b.backing && a.mapping==b.mapping && a.iova==b.iova && a.bytes==b.bytes &&
+        a.backing_offset==b.backing_offset && a.permissions==b.permissions && !a.reserved && !b.reserved;
+}
+}
+nr::Error NativeAdrenoResourceQueue::lookup(uint64_t handle,nr::Mapping *out) {
+    if(!owner_ || !by_handle_ || !out)return nr::Error::Invalid;
+    const auto status=by_handle_(context_,handle,out);
+    if(status!=nr::Error::Ok)return status;
+    return out->owner==owner_?nr::Error::Ok:nr::Error::Ownership;
+}
+nr::Error NativeAdrenoResourceQueue::revalidate(const nr::Mapping &mapping) {
+    nr::Mapping current{};const auto status=lookup(mapping.handle,&current);
+    if(status!=nr::Error::Ok)return status;
+    if(!same(mapping,current))return nr::Error::Stale;
+    uint64_t iova=0;size_t bytes=0;unsigned permissions=0;
+    if(vm_.describe(mapping.mapping,&iova,&bytes,&permissions) || iova!=mapping.iova ||
+       bytes!=mapping.bytes || permissions!=mapping.permissions)return nr::Error::Stale;
+    return nr::Error::Ok;
+}
+nr::Error NativeAdrenoResourceQueue::cacheMapping(const nr::CacheSpan &span,nr::Mapping *out) {
+    if(!by_backing_ || span.reserved || !span.bytes || !span.access ||
+       (span.access&~uint32_t(nr::Read|nr::Write|nr::Execute)))return nr::Error::Invalid;
+    auto status=by_backing_(context_,span.backing,out);if(status!=nr::Error::Ok)return status;
+    status=revalidate(*out);if(status!=nr::Error::Ok)return status;
+    // Initial path owns complete used BOs. Partial/shared imported-page aliases
+    // need a canonical backing+CPU ownership implementation before acceptance.
+    if(out->backing!=span.backing || out->backing_offset || span.offset || span.bytes!=out->bytes)
+        return nr::Error::Unsupported;
+    if((span.access&uint32_t(nr::Read|nr::Write))&~out->permissions)return nr::Error::Permission;
+    return nr::Error::Ok;
+}
+nr::Error NativeAdrenoResourceQueue::maintain(const nr::CacheSpan *spans,size_t count,bool acquire) {
+    if(!spans || !count || count>nr::MaxResources)return nr::Error::Invalid;
+    // No CPU maintenance while any prior job may still use the mapping. This
+    // initial path intentionally admits one native Job, never a legacy fallback.
+    if(!acquire && ring_.outstanding())return nr::Error::Busy;
+    for(size_t i=0;i<count;++i) {
+        nr::Mapping mapping{};const auto status=cacheMapping(spans[i],&mapping);
+        if(status!=nr::Error::Ok)return status;
+    }
+    for(size_t i=0;i<count;++i) {
+        if(acquire && !(spans[i].access&nr::Write))continue;
+        nr::Mapping mapping{};const auto status=cacheMapping(spans[i],&mapping);
+        if(status!=nr::Error::Ok)return status;
+        const auto maintained=acquire?vm_.acquireHeld(mapping.mapping):vm_.publishHeld(mapping.mapping);
+        if(maintained)return convert(maintained);
+    }
+    return nr::Error::Ok;
+}
+nr::SubmitResult NativeAdrenoResourceQueue::enqueue(uint64_t owner,uint64_t queue,const nr::Use *uses,
+    size_t use_count,const nr::Command *commands,size_t count) {
+    auto reject=[](nr::Error e){return nr::SubmitResult{e,nr::Acceptance::Rejected,0};};
+    if(owner!=owner_ || queue!=queue_)return reject(nr::Error::Ownership);
+    if(!uses || !use_count || use_count>nr::MaxResources || !commands || !count || count>nr::MaxIbs)
+        return reject(nr::Error::Invalid);
+    if(ring_.outstanding())return reject(nr::Error::Busy);
+    if(ring_.poisoned() || vm_.poisoned() || ring_.lastSubmitted()==UINT32_MAX)return reject(nr::Error::Backend);
+    for(size_t i=0;i<use_count;++i) {
+        const auto valid=revalidate(uses[i].mapping);if(valid!=nr::Error::Ok)return reject(valid);
+    }
+    uint32_t words[nr::MaxIbs*4];size_t word_count=0;
+    for(size_t i=0;i<count;++i) {
+        const auto &command=commands[i];
+        if(!command.bytes || (command.iova&3) || (command.bytes&3) || command.bytes>0xfffffu*4u)
+            return reject(nr::Error::Bounds);
+        bool covered=false;
+        for(size_t j=0;j<use_count;++j) {
+            const auto &use=uses[j];
+            if((use.access&(nr::Read|nr::Execute))!=(nr::Read|nr::Execute) ||
+               use.offset>use.mapping.bytes || use.bytes>use.mapping.bytes-use.offset)continue;
+            const uint64_t begin=use.mapping.iova+use.offset;
+            if(command.iova>=begin && command.iova-begin<=use.bytes &&
+               command.bytes<=use.bytes-(command.iova-begin)) {covered=true;break;}
+        }
+        if(!covered)return reject(nr::Error::Permission);
+        uint32_t header=0;if(AdrenoPM4Type7(0x3f,3,&header)!=AdrenoPM4Success)return reject(nr::Error::Backend);
+        words[word_count++]=header;words[word_count++]=uint32_t(command.iova);
+        words[word_count++]=uint32_t(command.iova>>32);words[word_count++]=uint32_t(command.bytes/4);
+    }
+    if(vm_.invalidateTlb())return reject(nr::Error::Backend);
+    uint32_t fence=0;const auto status=ring_.submitFramed(words,word_count,&fence);
+    if(!status && fence)return {nr::Error::Ok,nr::Acceptance::Accepted,fence};
+    // A nominally successful commit without a trackable fence is uncertain,
+    // even if a future Ring implementation forgets to mark itself poisoned.
+    if(!status || ring_.poisoned() || fence)return {nr::Error::Backend,nr::Acceptance::Uncertain,fence};
+    return reject(convert(status));
+}
+nr::Hooks NativeAdrenoResourceQueue::hooks() {
+    return {this,[](void *p,uint64_t handle,nr::Mapping *out) {
+        return static_cast<NativeAdrenoResourceQueue *>(p)->lookup(handle,out);
+    },[](void *p,const nr::Mapping &mapping) {
+        auto &q=*static_cast<NativeAdrenoResourceQueue *>(p);const auto valid=q.revalidate(mapping);
+        return valid==nr::Error::Ok?convert(q.vm_.holdJob(mapping.mapping)):valid;
+    },[](void *p,const nr::Mapping &mapping,nr::Release why) {
+        auto &q=*static_cast<NativeAdrenoResourceQueue *>(p);const auto valid=q.revalidate(mapping);
+        if(valid!=nr::Error::Ok)return valid;
+        return convert(why==nr::Release::BeforeSubmit?q.vm_.releaseUnsubmittedJob(mapping.mapping):
+                       q.vm_.retireJobAfterCompletion(mapping.mapping));
+    },[](void *p,const nr::CacheSpan *spans,size_t count) {
+        return static_cast<NativeAdrenoResourceQueue *>(p)->maintain(spans,count,false);
+    },[](void *p,uint64_t owner,uint64_t queue,const nr::Use *uses,size_t use_count,const nr::Command *commands,size_t count) {
+        return static_cast<NativeAdrenoResourceQueue *>(p)->enqueue(owner,queue,uses,use_count,commands,count);
+    },[](void *p,uint64_t fence) {
+        auto &q=*static_cast<NativeAdrenoResourceQueue *>(p);
+        if(!fence || fence>UINT32_MAX)return nr::Completion::Uncertain;
+        const auto status=q.ring_.wait(uint32_t(fence),&q.clock_,0,nullptr);
+        return status==NativeAdrenoRingFenceComplete?nr::Completion::Complete:
+            status==NativeAdrenoRingFenceTimeout?nr::Completion::Pending:nr::Completion::Uncertain;
+    },[](void *p,const nr::CacheSpan *spans,size_t count) {
+        return static_cast<NativeAdrenoResourceQueue *>(p)->maintain(spans,count,true);
+    },[](void *){return false;}, // No timeout/client-exit/reset assumption.
+    [](void *p,uint64_t owner,uint64_t queue) {
+        auto &q=*static_cast<NativeAdrenoResourceQueue *>(p);
+        if(owner!=q.owner_ || queue!=q.queue_)return nr::Error::Ownership;
+        if(q.ring_.poisoned() || q.vm_.poisoned() || q.ring_.lastSubmitted()==UINT32_MAX)return nr::Error::Backend;
+        return q.ring_.outstanding()?nr::Error::Busy:nr::Error::Ok;
+    }};
+}
