@@ -0,0 +1,39 @@
+// Owned AIR fixtures serialized by pinned Mesa 25.0.7 Zink; no Apple shader bytes.
+pub(super) const VERTEX: &[u32] = &[
+    0x07230203, 0x00010500, 0x00000000, 0x0000001e, 0x00000000, 0x00020011, 0x00000001, 0x0006000b,
