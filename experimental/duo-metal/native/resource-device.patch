@@ -0,0 +1,52 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_CACHE_BATCH_H
+#define NATIVE_ADRENO_CACHE_BATCH_H
+#include "NativeAdrenoMemory.h"
+
+/* Preserve the exact physical-page sequence, but keep a barrier/preemption run
+ * open across scatter-list boundaries. Ops::end() must complete all operations
+ * issued on the current CPU before allowing migration. No allocation or sort.
+ * Validate the entire requested interval before any cache operation. */
+template<class Ops>
+IOReturn NativeAdrenoVisitPhysicalPages(const NativeAdrenoPhysicalSpan *spans,
+    size_t count,size_t offset,size_t bytes,Ops &ops)
+{
+    if(!spans || !count || !bytes || ((offset|bytes)&4095) || offset>UINT64_MAX-bytes)
+        return kIOReturnBadArgument;
+    const uint64_t end=offset+bytes;
+    uint64_t covered=offset,previous=0;
+    for(size_t i=0;i<count;++i) {
+        const auto &s=spans[i];
+        if(!s.bytes || !s.physical || ((s.offset|s.physical|s.bytes)&4095) ||
+            s.offset>UINT64_MAX-s.bytes || s.physical>UINT64_MAX-s.bytes ||
+            (i && s.offset<previous))return kIOReturnBadArgument;
+        previous=s.offset+s.bytes;
+        const uint64_t first=offset>s.offset?offset:s.offset;
+        const uint64_t last=end<previous?end:previous;
+        if(first>=last)continue;
+        if(first!=covered)return kIOReturnBadArgument;
+        covered=last;
+    }
+    if(covered!=end)return kIOReturnBadArgument;
+
+    unsigned run=0;
+    for(size_t i=0;i<count;++i) {
+        const auto &s=spans[i];
+        const uint64_t first=offset>s.offset?offset:s.offset;
+        const uint64_t last=end<s.offset+s.bytes?end:s.offset+s.bytes;
+        for(uint64_t at=first;at<last;at+=4096) {
+            if(!run) {
+                const IOReturn status=ops.begin();
+                if(status)return status; // begin must undo its own partial setup
+            }
+            const IOReturn status=ops.page(s.physical+at-s.offset);
+            if(++run==64 || status) {
+                ops.end();run=0;
+                if(status)return status;
+            }
+        }
+    }
+    if(run)ops.end();
+    return kIOReturnSuccess;
+}
+#endif
