+// ---- Metal's own bases ----
+// Every Metal object of Apple's drivers derives from a private base in Metal.framework (_MTLCommandBuffer, _MTLCommandEncoder,
+// _MTLResource, ...) that implements what all its kind share: the label, the trace identity (globalTraceObjectID), the command buffer's
+// userDictionary, and the protocol the frameworks test (MPS's MPSCommandBufferImageCache returns nil for a command buffer that does not
+// conform to MTLCommandBuffer, and HelloView's blur then read through the nil cache: SpringBoard sb7-v1). On NSObject each such method
+// was a crash in whichever framework sent it first. The queue, command buffer, encoders, buffers, textures, pipelines, samplers and
+// depth-stencil states derive from these bases, as Chlorophyll's do (ry-diffusion/Chlorophyll, src/bgmtl.m, on iOS 18), through the
+// initializers Metal's drivers call (all present in 23F84). Names only here: the layouts are Metal's, and this file's instance
+// variables follow them (non-fragile ivars). A method this file implements overrides the base's.
+@interface _MTLObjectWithLabel : NSObject
+@property(copy) NSString *label;
+@end
+@interface _MTLResource : _MTLObjectWithLabel
+@end
+@interface _MTLCommandQueue : _MTLObjectWithLabel
+- (instancetype)initWithDevice:(id)device maxCommandBufferCount:(NSUInteger)count;   // the descriptor form takes an iOS 18 class
+@end
+@interface _MTLCommandBuffer : _MTLObjectWithLabel
+- (instancetype)initWithQueue:(id)queue retainedReferences:(BOOL)retained synchronousDebugMode:(BOOL)synchronous;
+@end
+@interface _MTLCommandEncoder : _MTLObjectWithLabel
+- (instancetype)initWithCommandBuffer:(id)commandBuffer;
+- (void)endEncoding;
+@end
+@interface _MTLComputePipelineState : _MTLObjectWithLabel
+- (instancetype)initWithDevice:(id)device pipelineStateDescriptor:(id)descriptor;
+@end
+@interface _MTLRenderPipelineState : _MTLObjectWithLabel
+- (instancetype)initWithDevice:(id)device pipelineStateDescriptor:(id)descriptor;
+@end
+@interface _MTLSamplerState : NSObject
+- (instancetype)initWithDevice:(id)device samplerDescriptor:(id)descriptor;
+@property(copy) NSString *label;
+@end
+@interface _MTLDepthStencilState : NSObject
+- (instancetype)initWithDevice:(id)device depthStencilDescriptor:(id)descriptor;
+@property(copy) NSString *label;
+@end
+// What NBObject gives its subclasses, for the classes on Metal's bases: the device is this one, and a selector neither this file nor the
