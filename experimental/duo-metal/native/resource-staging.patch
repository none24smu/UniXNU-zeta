+        assert(is(h.begin(),tx::Status::NoMemory) && h.f.live_allocations==1);
+        h.f.fail_allocation=0;assert(is(h.begin(),tx::Status::Ok));
+        assert(h.session->token().generation==2);h.destroy();++cases;
+    }
+    for(size_t failure=1;failure<=5;++failure) {
+        Harness h;assert(is(h.begin(),tx::Status::Ok));h.upload();
+        h.f.fail_allocation=h.f.allocations+failure;const auto packet=h.request(tx::Operation::Seal);
+        assert(is(h.call(packet),tx::Status::NoMemory) && h.f.live_allocations==3);
+        assert(!h.f.holds && !h.f.enqueues);h.f.fail_allocation=0;
+        assert(is(h.call(packet),tx::Status::Ok));h.destroy();++cases;
+    }
+    {
+        Fixture f;tx::Session *session=nullptr;
+        assert(tx::Session::create(99,123,{},f.allocator(),f.hooks(),&session)==nr::Error::Unsupported);
