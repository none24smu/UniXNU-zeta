+#[test]
+fn imported_stage_uses_the_existing_cache_contract() {
+    let device = device();
+    let original = device
+        .profile()
+        .import_resource_free_spirv(&input(&device, FRAGMENT, false))
+        .unwrap();
+    let bytes = original.to_bytes();
+    let restored = CompiledFunction::from_bytes_for_key(&bytes, original.key(), &device).unwrap();
+    assert_eq!(original, restored);
+    let foreign = FunctionCompileKey::new([7; 32]);
+    assert!(CompiledFunction::from_bytes_for_key(&bytes, &foreign, &device).is_err());
+    let mut corrupt = bytes;
+    let end = corrupt.len() - 1;
+    corrupt[end] ^= 1;
+    assert!(CompiledFunction::from_bytes_for_key(&corrupt, original.key(), &device).is_err());
+    let mut descriptor = descriptor(&device, PixelFormat::RGBA32Float);
+    let direct = device
+        .compile_render_pipeline(&descriptor, &Budget::standard())
+        .unwrap();
+    descriptor.fragment = Some(StageSource::Compiled(restored));
+    assert_eq!(
+        direct,
+        device
+            .compile_render_pipeline(&descriptor, &Budget::standard())
+            .unwrap()
+    );
+}
+
+#[test]
+fn rgba8_constant_fold_uses_real_linker_and_refuses_other_contracts() {
+    let device = device();
+    let mut descriptor = descriptor(&device, PixelFormat::RGBA8Unorm);
+    let profile = device.profile();
+    let vertex = profile
+        .import_resource_free_spirv_for_pipeline(&input(&device, VERTEX, true), &descriptor)
+        .unwrap();
+    let fragment = profile
+        .import_resource_free_spirv_for_pipeline(&input(&device, FRAGMENT, false), &descriptor)
+        .unwrap();
+    assert_eq!(fragment.artifact().module.words.len(), FRAGMENT.len() + 23);
+    assert_ne!(fragment.artifact().module.words, FRAGMENT);
+    descriptor.vertex = StageSource::Compiled(vertex);
+    descriptor.fragment = Some(StageSource::Compiled(fragment.clone()));
+    let pipeline = device
+        .compile_render_pipeline(&descriptor, &Budget::standard())
+        .unwrap();
+    assert_eq!(pipeline.stages[1].rounded_colors, vec![0]);
+    assert_eq!(
+        pipeline.stages[1].strategies.entries["external.unorm8_constant_fold"].uses,
+        1
+    );
+    for stage in &pipeline.stages {
+        crate::spirv::testing::check_words_valid(&stage.spirv, &pipeline.requirements, profile)
+            .unwrap();
+    }
+    assert!(pipeline
+        .plan(&device, &crate::bind::BindShape::default())
+        .unwrap()
+        .descriptors
+        .is_empty());
+    for lane in [0.25f32, 0.5, 0.125] {
+        let lowered = f32::from_bits(color0::unorm8_constant(lane.to_bits()));
+        assert_eq!(
+            (lowered * 255.0).round_ties_even() as u8,
+            (f64::from(lane) * 255.0).round_ties_even() as u8
+        );
+    }
+    let mut changes = Vec::new();
+    let mut d = descriptor.clone();
+    d.color_attachments[0].as_mut().unwrap().blending_enabled = true;
+    changes.push(d);
+    let mut d = descriptor.clone();
+    d.color_attachments[0].as_mut().unwrap().write_mask = crate::metal::ColorWriteMask::RED;
+    changes.push(d);
+    let mut d = descriptor.clone();
+    d.alpha_to_coverage = true;
+    changes.push(d);
+    let mut d = descriptor.clone();
+    d.raster_sample_count = 4;
+    changes.push(d);
+    let mut d = descriptor.clone();
+    d.color_attachments[0].as_mut().unwrap().pixel_format = PixelFormat::BGRA8Unorm;
+    changes.push(d);
+    let mut d = descriptor.clone();
+    d.color_attachments[1] = d.color_attachments[0];
+    changes.push(d);
+    let mut d = descriptor.clone();
+    d.input_primitive_topology = crate::metal::PrimitiveTopologyClass::Point;
+    changes.push(d);
+    for d in changes {
+        assert_eq!(
+            profile
+                .import_resource_free_spirv_for_pipeline(&input(&device, FRAGMENT, false), &d)
+                .unwrap_err(),
+            ExternalSpirvError::RenderContract
+        );
+    }
+    assert_ne!(
+        profile
+            .import_resource_free_spirv(&input(&device, FRAGMENT, false))
+            .unwrap()
+            .key(),
+        fragment.key()
+    );
+}
